          "Buprenorphine partial agonism",
          "Ceiling effect helps safety but induction timing matters."
        ],
        [
          "Parkinsonian dopamine deficit",
          "Levodopa plus carbidopa",
          "Long-term use can produce motor fluctuations."
        ],
        [
          "Mild/moderate Alzheimer symptoms",
          "Acetylcholinesterase inhibition",
          "Symptomatic benefit, not disease reversal."
        ],
        [
          "Moderate/severe Alzheimer symptoms",
          "Memantine NMDA open-channel block",
          "Effect size is modest and patient-specific."
        ]
      ]
