        [
          "CML targeted therapy",
          "BCR-ABL / Philadelphia chromosome",
          "Resistance mutations can require next-generation TKIs."
        ],
        [
          "NSCLC targeted option",
          "EGFR, ALK, KRAS G12C and related biomarkers",
          "Histology and sequencing quality matter."
        ],
