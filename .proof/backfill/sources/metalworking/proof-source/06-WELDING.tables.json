      "headers": [
        "Situation",
        "Best Process"
      ],
      "rows": [
        [
          "Field repair, no gas supply, wind",
          "SMAW (self-shielded or FCAW-S)"
        ],
        [
          "Production steel fabrication, flat/horiz",
          "GMAW spray or SAW"
        ],
        [
          "Out-of-position structural",
          "GMAW short-circuit or FCAW"
        ],
        [
          "Thin stainless, titanium, root pass",
          "GTAW"
        ],
        [
          "Heavy plate (>25mm) high volume",
          "SAW"
        ],
        [
          "Aluminum aerospace (no HAZ crack)",
          "FSW or GMAW pulse"
        ],
        [
          "Automotive body panels",
          "Resistance spot"
        ],
        [
          "Detect internal defects volumetrically",
          "RT (porosity/slag) or UT/PAUT (cracks)"
        ],
        [
          "Detect surface crack, non-ferrous",
          "PT"
        ],
        [
          "Detect surface/near-surface, ferrous",
          "MT"
        ],
        [
          "High-carbon/alloy steel welding",
          "Preheat per CE + PWHT if required"
        ],
        [
          "Austenitic SS to avoid sensitization",
          "Use 304L/316L or solution anneal"
        ]
