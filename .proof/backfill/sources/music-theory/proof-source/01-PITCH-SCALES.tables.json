      "heading_context": "## Decision Cheat Sheet",
      "headers": [
        "I want to...",
        "Use this"
      ],
      "rows": [
        [
          "Find a note n semitones above f₀",
          "f₀ × 2^(n/12)"
        ],
        [
          "Express deviation from 12-TET",
          "Cents = 1200 × log₂(f₁/f₂)"
        ],
        [
          "Build any major scale",
          "Start on root, apply WWHWWWH"
        ],
        [
          "Find relative minor",
          "Go to scale degree 6 of the major"
        ],
        [
          "Find parallel minor",
          "Same tonic, lower ♭3 ♭6 ♭7"
        ],
        [
          "Get V7 in minor",
          "Use harmonic minor (raised 7th)"
        ],
        [
          "Smooth ascending line to tonic in minor",
          "Melodic minor ascending"
        ],
        [
          "Remember sharps order",
          "F C G D A E B"
        ],
        [
          "Remember flats order",
          "B E A D G C F"
        ],
        [
          "Identify interval",
          "Count letter-names, check against major scale"
        ]
