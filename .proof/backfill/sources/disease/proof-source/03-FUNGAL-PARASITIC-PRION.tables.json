      "heading_context": "## Parasites: Helminths",
      "headers": [
        "Organism",
        "Transmission",
        "Pathogenesis",
        "Key features"
      ],
      "rows": [
        [
          "Ascaris lumbricoides",
          "Fecal-oral (eggs → soil → food)",
          "Migration through lung (Löffler's syndrome: eosinophilia + pulmonary infiltrates)",
          "Large roundworm; intestinal obstruction in heavy infections"
        ],
        [
          "Hookworm (Ancylostoma, Necator)",
          "Skin penetration (walking barefoot)",
          "Iron deficiency anemia (blood-suckers); larvae cause cutaneous larva migrans",
          "\"Ground itch\" entry; chronic anemia in children"
        ],
        [
          "Strongyloides stercoralis",
          "Skin penetration",
          "Autoinfection cycle — can persist decades; hyperinfection in immunocompromised (carries gut bacteria → sepsis)",
          "Only worm with autoinfection; ivermectin treatment"
        ],
        [
          "Trichinella spiralis",
          "Undercooked meat (pork, wild game)",
          "Larvae encyst in skeletal muscle",
          "Periorbital edema, myalgia, eosinophilia, splinter hemorrhages"
        ],
        [
          "Filaria (Wuchereria, Brugia)",
          "Mosquito bite (microfilariae)",
          "Lymphatic blockage → lymphedema → elephantiasis",
          "Microfilariae in blood (nocturnal periodicity); DEC + albendazole; doxycycline kills Wolbachia"
        ],
        [
          "Onchocerca volvulus",
          "Black fly (Simulium)",
          "Microfilariae in skin/eye → immune response → river blindness",
          "Second leading infectious cause of blindness; ivermectin mass drug administration"
        ]
      ]
    },
