      "headers": [
        "Question",
        "Answer"
      ],
      "rows": [
        [
          "Is a prior court decision binding on this court?",
          "Only if same/higher court in same jurisdiction; ratio decidendi (not dicta)"
        ],
        [
          "What standard to overturn a factual finding on appeal?",
          "Clear error (deferential)"
        ],
        [
          "What to win on motion to dismiss?",
          "Show complaint plausibly alleges all elements (Twombly/Iqbal)"
        ],
        [
          "Who wins if statute and common law conflict?",
          "Statute wins (unless unconstitutional)"
        ],
        [
          "Who wins if federal and state law conflict?",
          "Federal law wins (Supremacy Clause)"
        ],
        [
          "What constitutional review applies to racial classification?",
          "Strict scrutiny"
        ],
        [
          "Civil burden of proof?",
          "Preponderance (>50%); clear and convincing for some claims"
        ],
        [
          "Where to sue a corporation?",
          "State of incorporation, principal place of business, or where cause of action arose"
        ]
      ]
