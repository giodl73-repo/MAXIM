        [
          "Reduce stone castle",
          "Starvation or mining (until artillery)",
          "Siege was the dominant mode; assault rarely succeeded"
        ],
        [
          "Defeat defending archers",
          "Cavalry charge before they deploy",
          "Agincourt failed because of mud/stakes"
