      "id": "table-2",
      "line": 249,
      "heading_context": "## Decision Cheat Sheet — Which IT Tool for What?",
      "headers": [
        "Problem",
        "Tool",
        "Formula/Result"
      ],
      "rows": [
        [
          "How much can I compress X?",
          "Entropy H(X)",
          "Min bits/symbol = H(X)"
        ],
        [
          "What's redundancy in X?",
          "H(X) vs log\\|X\\|",
          "R = 1 - H(X)/log\\|X\\|"
        ],
        [
          "How much info Y gives about X?",
          "Mutual information I(X;Y)",
          "I = H(X) + H(Y) - H(X,Y)"
        ],
        [
          "How channel max rate?",
          "Channel capacity C",
          "C = max_{p(x)} I(X;Y) bits/use"
        ],
        [
          "How similar are P and Q?",
          "KL divergence D(P\\|\\|Q)",
          "≥0, = 0 iff P=Q"
        ],
        [
          "How to choose model?",
          "MDL = K(model) + K(data\\|model)",
          "Shortest description wins"
        ],
        [
          "Minimum energy to erase 1 bit?",
          "Landauer limit",
          "k_B T ln 2 ≈ 3×10⁻²¹ J"
        ],
        [
          "Can I communicate at rate R?",
          "Shannon capacity C",
          "Yes iff R < C"
        ],
        [
          "How many secret bits from QKD?",
          "S(ρ) + eavesdropper error",
          "BB84 key rate formula"
        ]
      ]
    }
