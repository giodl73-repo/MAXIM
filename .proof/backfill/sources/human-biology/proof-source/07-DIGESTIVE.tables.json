        [
          "Fat lymphatic route",
          "Chylomicron size and lacteal uptake",
          "Medium-chain fats can enter portal blood directly."
        ],
        [
          "Zymogen activation",
          "Enteropeptidase-triggered trypsin cascade",
          "Premature activation is pancreatitis logic."
        ],
