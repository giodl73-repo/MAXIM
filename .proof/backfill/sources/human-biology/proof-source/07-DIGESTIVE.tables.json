    {
      "id": "table-2",
      "line": 278,
      "heading_context": "## GI Hormones",
      "headers": [
        "Hormone",
        "Source",
        "Trigger",
        "Key actions"
      ],
      "rows": [
        [
          "Gastrin",
          "G cells (antrum)",
          "Protein, distension, vagus",
          "↑ HCl, ↑ pepsinogen, ↑ ECL histamine, ↑ motility, trophic"
        ],
        [
          "Secretin",
          "S cells (duodenum)",
          "Acid in duodenum",
          "↑ Pancreatic HCO₃⁻, ↓ gastric acid, ↑ bile flow"
        ],
        [
          "CCK (cholecystokinin)",
          "I cells (duodenum)",
          "Fat + protein in duodenum",
          "↑ Pancreatic enzymes, gallbladder contraction, ↓ gastric emptying, satiety"
        ],
        [
          "GIP (glucose-dependent insulinotropic peptide)",
          "K cells (duodenum)",
          "Glucose + fat",
          "↑ Insulin (incretin), ↓ gastric acid"
        ],
        [
          "GLP-1",
          "L cells (ileum)",
          "Nutrients",
          "↑ Insulin, ↓ glucagon, ↓ gastric emptying, satiety"
        ],
        [
          "Motilin",
          "M cells (duodenum)",
          "Fasting (interdigestive)",
          "Migrating motor complex (housekeeping waves between meals)"
        ],
        [
          "VIP",
          "Myenteric neurons",
          "Neural",
          "Relax gut smooth muscle, ↑ secretion"
        ],
        [
          "Somatostatin",
          "D cells (throughout)",
          "Acid, fat, protein",
          "Global inhibitor: ↓ most GI hormones and secretions"
        ]
      ]
    },
