          "Osteocyte",
          "Osteoblast trapped in lacuna",
          "Mechanosensation; regulate remodeling via sclerostin and RANKL signaling"
        ],
        [
          "Osteoclast",
          "Hematopoietic (monocyte lineage)",
          "Resorb bone: acidify lacuna (carbonic anhydrase → HCl), protease (cathepsin K) dissolves matrix"
        ]
      ]
