      "headers": [
        "If you need to diagnose...",
        "Start With",
        "Key Caveat"
      ],
      "rows": [
        [
          "Spinal reflex integration",
          "Monosynaptic stretch reflex in spinal cord",
          "Brain modulates reflexes but is not required for arc."
        ],
        [
          "Ipsilateral cerebellar ataxia",
          "Cerebellar output maps to same-side body",
          "Corticospinal lesions behave differently."
        ],
        [
          "Hypothalamic function boundary",
          "Homeostatic, autonomic, endocrine control",
          "Voluntary movement/language/perception are not hypothalamic."
        ],
        [
          "Sympathetic versus parasympathetic spread",
          "Short preganglionic sympathetic chain divergence",
          "Parasympathetic output is more local and targeted."
        ],
        [
          "BBB drug crossing",
          "Lipophilic, low MW, not P-gp substrate",
          "Transporters and protein binding complicate the rule."
        ],
        [
          "Non-thalamic sensory route",
          "Olfaction to piriform/amygdala",
          "Later olfactory processing still interacts with thalamocortical systems."
        ]
      ]
