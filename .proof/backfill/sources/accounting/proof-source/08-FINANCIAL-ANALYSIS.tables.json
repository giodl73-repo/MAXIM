      "headers": [
        "Return",
        "Formula",
        "Measures"
      ],
      "rows": [
        [
          "**ROA**",
          "Net income / Total assets",
          "Profit per dollar of assets (operating efficiency)"
        ],
        [
          "**ROE**",
          "Net income / Shareholders' equity",
          "Profit per dollar of owner capital"
        ],
        [
          "**ROIC**",
          "NOPAT / Invested capital",
          "Return on capital *actually deployed*, financing-neutral"
        ]
      ]
    },
    {
