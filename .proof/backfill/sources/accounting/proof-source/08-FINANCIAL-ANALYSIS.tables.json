      "heading_context": "## Family 1: Liquidity — Can It Pay Near-Term?",
      "headers": [
        "Ratio",
        "Formula",
        "Reads as"
      ],
      "rows": [
        [
          "**Current ratio**",
          "Current assets / Current liabilities",
          "Broad short-term cushion"
        ],
        [
          "**Quick ratio (acid test)**",
          "(Current assets − Inventory) / Current liabilities",
          "Cushion *excluding* hard-to-sell inventory"
        ],
        [
          "**Cash ratio**",
          "(Cash + equivalents) / Current liabilities",
          "Most conservative — cash only"
        ]
      ]
    },
    {
      "id": "table-2",
      "line": 91,
      "heading_context": "## Family 2: Leverage — How Much Debt, Can It Service?",
      "headers": [
        "Ratio",
        "Formula",
        "Reads as"
      ],
      "rows": [
        [
          "**Debt-to-equity**",
          "Total debt / Total equity",
          "$ of debt per $ of equity"
        ],
        [
          "**Debt-to-assets**",
          "Total debt / Total assets",
          "Fraction of assets funded by debt"
        ],
        [
          "**Interest coverage (TIE)**",
          "EBIT / Interest expense",
          "How many times earnings cover interest"
        ],
        [
          "**Net debt / EBITDA**",
          "(Debt − Cash) / EBITDA",
          "Years of earnings to repay net debt"
        ]
      ]
    },
