      "headers": [
        "Method",
        "Assumes you sell...",
        "In rising prices →",
        "LIFO allowed?"
      ],
      "rows": [
        [
          "**FIFO**",
          "Oldest units first",
          "Lower COGS, higher profit, higher tax",
          "Yes (GAAP & IFRS)"
        ],
        [
          "**LIFO**",
          "Newest units first",
          "Higher COGS, lower profit, lower tax",
          "**GAAP only — IFRS bans it**"
        ],
        [
          "**Weighted average**",
          "Blended cost",
          "Between FIFO and LIFO",
          "Yes (GAAP & IFRS)"
        ]
      ]
