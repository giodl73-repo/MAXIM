      "headers": [
        "Operator",
        "What it computes",
        "Notes"
      ],
      "rows": [
        [
          "Sobel / Prewitt",
          "First derivative (gradient)",
          "Cheap; gives magnitude + direction"
        ],
        [
          "Laplacian",
          "Second derivative (`div grad`)",
          "Zero-crossings = edges; noise-sensitive"
        ],
        [
          "LoG / Marr-Hildreth",
          "Laplacian of Gaussian",
          "Smooth then Laplacian; blob/edge detector"
        ],
        [
          "Canny",
          "Multi-stage gradient pipeline",
          "Best general-purpose edge map"
        ]
      ]
    },
