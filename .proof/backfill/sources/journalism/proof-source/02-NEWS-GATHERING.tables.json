      "heading_context": "## Decision Cheat Sheet",
      "headers": [
        "Situation",
        "Gathering Approach"
      ],
      "rows": [
        [
          "Breaking news, unknown facts",
          "Official sources first, verify with witnesses"
        ],
        [
          "Investigative tip",
          "Document it before pursuing; assess source motive"
        ],
        [
          "Government records needed",
          "FOIA first; identify correct agency"
        ],
        [
          "Corporate malfeasance",
          "SEC filings + court records + FOIA of relevant agencies"
        ],
        [
          "Election accountability",
          "FEC filings + state campaign finance databases"
        ],
        [
          "Source wants deep background",
          "Establish rules before source begins speaking"
        ],
        [
          "Key source refuses to go on record",
          "Seek documentary corroboration; pursue other sources"
        ],
        [
          "Viral social media claim",
          "Reverse image search + source metadata + original context"
        ]
      ]
    }
