      "headers": [
        "Method",
        "Establishes",
        "Strength",
        "Weakness"
      ],
      "rows": [
        [
          "Focus group / interview (qual)",
          "Hypotheses",
          "Depth, \"why\"",
          "Not projectable, biased"
        ],
        [
          "Survey (descriptive)",
          "Correlation, magnitudes",
          "Scale, projectable",
          "Stated != revealed; bias risk"
        ],
        [
          "Conjoint",
          "Trade-offs, WTP",
          "Revealed trade-offs, simulatable",
          "Hypothetical context"
        ],
        [
