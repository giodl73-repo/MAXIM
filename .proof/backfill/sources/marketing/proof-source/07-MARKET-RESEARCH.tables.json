      "id": "table-2",
      "line": 173,
      "heading_context": "## Sampling",
      "headers": [
        "Concept",
        "Meaning",
        "Why it matters"
      ],
      "rows": [
        [
          "**Sampling frame**",
          "The list you draw from",
          "If the frame omits people, results are biased before you start"
        ],
        [
          "**Sampling error**",
          "Random variation from sampling",
          "Shrinks with sample size (~1/sqrt(n)); quantifiable"
        ],
        [
          "**Non-sampling error**",
          "Bias (coverage, non-response, measurement)",
          "*Doesn't* shrink with n — a bigger biased sample is just confidently wrong"
        ],
        [
          "**Margin of error**",
          "CI half-width at a confidence level",
          "The honest uncertainty band on an estimate"
        ]
      ]
    },
    {
