      "headers": [
        "Architecture",
        "When to use",
        "Trade-off"
      ],
      "rows": [
        [
          "**Branded house**",
          "Coherent offerings, shared values, B2B/tech",
          "Cheap extensions; correlated risk"
        ],
        [
          "**Sub-brands**",
          "Related but distinct lines",
          "Some transfer + some distinctiveness"
        ],
        [
          "**Endorsed brands**",
          "Distinct products needing parent credibility",
          "Moderate cost, moderate transfer"
        ],
        [
          "**House of brands**",
          "Diverse segments, risk isolation, CPG",
          "Full CAC per brand; no shared equity"
        ]
      ]
