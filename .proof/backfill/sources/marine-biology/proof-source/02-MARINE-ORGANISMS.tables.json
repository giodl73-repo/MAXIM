      ],
      "rows": [
        [
          "Procellariiformes",
          "Wandering albatross (3.5 m wingspan)",
          "Dynamic soaring: extract energy from wind gradient over waves; can fly 1,000 km/day"
        ],
        [
          "Sphenisciformes",
          "Emperor penguin",
          "Flightless; counter-current heat exchange in flippers; dives to 565 m"
        ],
        [
          "Suliformes",
          "Blue-footed booby, frigatebird",
          "Plunge diving; frigatebirds cannot land on water (no waterproofing)"
        ],
        [
          "Pelecaniformes",
          "Brown pelican, gannet",
          "Plunge diving; pouch for fish capture"
        ],
        [
          "Charadriiformes",
          "Puffins, guillemots, terns",
          "Wing-propelled diving underwater; arctic tern migrates 70,000 km/year"
        ]
