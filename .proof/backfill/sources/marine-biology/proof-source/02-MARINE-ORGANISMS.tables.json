      "rows": [
        [
          "Scyphozoa (jellyfish)",
          "*Aurelia*, *Cyanea* (lion's mane: up to 37 m bell)",
          "Medusa dominant; nematocysts for prey capture; no brain, no blood"
        ],
        [
          "Anthozoa",
          "Corals, sea anemones",
          "Polyp dominant; no medusa stage; reef builders"
        ],
        [
          "Hydrozoa",
          "Portuguese man o'war, hydroids",
          "Colonial; siphonophores (Physalia) = integrated colony, not single organism"
        ],
        [
          "Cubozoa",
          "Box jellyfish",
          "Most venomous marine animal; *Chironex fleckeri* — lethal in minutes"
        ]
      ]
