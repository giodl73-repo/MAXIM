        [
          "Completion",
          "What observable fact means the work is complete?"
        ],
        [
          "Retry",
          "Who retries, with what identity, budget, and backoff?"
        ],
        [
          "Durability",
          "Which state survives process or device loss?"
        ],
        [
          "Cancellation",
          "Which work can stop, and what partial effects remain?"
        ],
        [
