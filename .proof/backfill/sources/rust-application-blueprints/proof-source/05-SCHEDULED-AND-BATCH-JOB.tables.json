        "Choices"
      ],
      "rows": [
        [
          "Window basis",
          "event time, source commit time, or scheduler time"
        ],
        [
          "Boundaries",
          "usually half-open `[start, end)`"
        ],
        [
          "Time zone",
          "UTC or named business zone with calendar rules"
        ],
        [
          "Late input",
          "ignore, next run, correction run, or reopen window"
        ],
        [
          "Overlap",
          "forbid, queue, replace, or allow disjoint partitions"
        ],
        [
          "Missed run",
          "catch up all, coalesce, or skip with explicit evidence"
