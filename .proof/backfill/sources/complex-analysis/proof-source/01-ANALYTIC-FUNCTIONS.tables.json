        [
          "Is f(z) holomorphic?",
          "Check CR: ∂u/∂x = ∂v/∂y, ∂u/∂y = −∂v/∂x"
        ],
        [
          "Where does f fail to be holomorphic?",
          "Where CR fails, or partials don't exist"
        ],
        [
          "What is the radius of convergence?",
          "Cauchy-Hadamard: 1/R = limsup \\|aₙ\\|^{1/n}"
        ],
        [
          "Does a harmonic conjugate exist?",
          "Yes, if domain is simply connected"
        ],
        [
          "Is f conformal?",
          "Yes, at points where f'(z) ≠ 0"
        ],
        [
          "What does f'(z₀) = 0 mean geometrically?",
          "Angles multiplied by order of zero"
        ],
        [
          "Is f(z) = z̄ holomorphic?",
          "No — CR fails everywhere"
        ]
      ]
    }
