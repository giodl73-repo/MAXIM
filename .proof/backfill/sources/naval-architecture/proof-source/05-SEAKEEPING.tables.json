      "heading_context": "## Layer 3: The Response Amplitude Operator (RAO)",
      "headers": [
        "Regime",
        "Wave vs. ship",
        "Behavior"
      ],
      "rows": [
        [
          "Low frequency (long waves)",
          "Wave ≫ ship period",
          "Ship rides the wave like a cork; RAO → 1 (it just follows the surface)"
        ],
        [
          "Resonance (ω_e ≈ ω_n)",
          "Encounter period = natural period",
          "RAO peaks — the dangerous regime; magnification set by damping"
        ],
        [
          "High frequency (short waves)",
          "Wave ≪ ship period",
          "Ship too sluggish to respond; RAO → 0"
        ]
      ]
    },
