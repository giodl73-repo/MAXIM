        ],
        [
          "Existing enterprise SSO (SAML)",
          "SAML 2.0 (legacy) or migrate to OIDC"
        ],
        [
          "Fine-grained document/resource sharing",
          "ReBAC (SpiceDB, OpenFGA)"
        ],
        [
          "Production database access by engineer",
          "PAM with JIT (Azure PIM)"
        ],
        [
          "Service needs SQL connection string",
          "Key Vault reference in app config (not hardcoded)"
