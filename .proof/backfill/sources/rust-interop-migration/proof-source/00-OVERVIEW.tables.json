      "heading_context": "## Boundary Hazard Register",
      "headers": [
        "Hazard",
        "Default posture"
      ],
      "rows": [
        [
          "ABI",
          "Use a specified C/system ABI, protocol, schema, or WIT contract; never promise the unstable Rust ABI or trait-object layout."
        ],
        [
          "Allocator",
          "The allocating side frees, or the API exposes a matched release function; never assume heaps or CRTs are interchangeable."
        ],
        [
          "Panic/unwind",
          "Catch and translate Rust panics where unwind is enabled; never let unwinding cross an ordinary foreign boundary."
        ],
        [
          "Lifetime",
          "Prefer copied values or opaque owned handles; every borrowed pointer has a stated validity interval and thread rule."
        ],
        [
          "Threading",
          "State affinity, reentrancy, callback thread, synchronization, and cancellation semantics."
        ],
        [
          "Target",
          "Test the exact OS/architecture/libc-or-CRT/calling-convention/runtime matrix."
        ],
        [
          "Packaging",
          "Treat library discovery, loader paths, symbols, signing, debug artifacts, and dependency closure as contract work."
        ]
      ]
    },
