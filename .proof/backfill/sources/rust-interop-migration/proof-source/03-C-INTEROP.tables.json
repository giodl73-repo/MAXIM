      "headers": [
        "Need",
        "Pattern"
      ],
      "rows": [
        [
          "Stable native object boundary",
          "Opaque handle plus versioned C functions"
        ],
        [
          "Borrow input only during call",
          "Pointer plus length, validated before slice creation"
        ],
        [
          "Return variable data",
          "Caller-provided buffer/two-call sizing or Rust object plus Rust free"
        ],
        [
          "Call a broad existing C library",
          "`bindgen` for declarations, handwritten safe facade"
        ],
        [
          "Publish a Rust C API",
          "`cbindgen` or reviewed manual header plus ABI tests"
        ],
        [
          "Cross-thread use",
          "Explicit thread-safe handle contract; internal synchronization if promised"
        ],
        [
          "Rich polymorphic API",
          "Keep polymorphism behind opaque handle; do not export Rust trait objects"
        ]
      ]
