      "heading_context": "## Decision Cheat Sheet",
      "headers": [
        "Parameter",
        "Effect",
        "Key Relation"
      ],
      "rows": [
        [
          "Angle of attack",
          "↑ α → ↑ CL (until stall)",
          "CL = 2π(α - α₀) [thin airfoil]"
        ],
        [
          "Aspect ratio",
          "↑ AR → ↓ induced drag",
          "CDi = CL²/(πeAR)"
        ],
        [
          "Reynolds number",
          "↑ Re → ↑ skin friction; ↓ separation",
          "Re = ρVL/μ"
        ],
        [
          "Mach number",
          "↑ M → ↑ CL (Prandtl-Glauert); above Mcrit: wave drag",
          "CL ∝ 1/√(1-M²)"
        ],
        [
          "Wing sweep",
          "↑ Λ → ↑ Mcrit; ↓ effective CLα",
          "Mcrit ∝ 1/cos Λ (approx)"
        ],
        [
          "Flaps deployed",
          "↑ CL_max; ↑ CD; nose-down moment",
          "ΔCL_max ≈ 0.3-2.0 depending on type"
        ]
      ]
    }
  ]
