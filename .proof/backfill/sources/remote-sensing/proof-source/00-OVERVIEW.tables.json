        "Resolution Type",
        "Definition",
        "Range",
        "Trade-off"
      ],
      "rows": [
        [
          "**Spatial**",
          "Ground footprint per pixel",
          "0.3m (WorldView) to 40km (SMAP)",
          "Finer pixels = narrower swath = longer revisit"
        ],
        [
          "**Spectral**",
          "Number and width of bands",
          "4 bands (PAN+RGB) to 285 (EMIT)",
          "More bands = less light per band = lower SNR"
        ],
        [
          "**Temporal**",
          "Time between repeat observations",
          "5 min (GOES) to 91 days (ICESat-2)",
          "Faster revisit = wider swath = coarser spatial"
        ],
        [
          "**Radiometric**",
          "Sensitivity to signal differences",
          "8-bit (256 DN) to 14-bit (16384 DN)",
          "Higher bit depth = better faint-signal detection"
        ]
      ]
