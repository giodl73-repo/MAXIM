      "line": 480,
      "heading_context": "## Decision Cheat Sheet",
      "headers": [
        "Problem",
        "Solution"
      ],
      "rows": [
        [
          "Scale in water heater, fixtures",
          "Ion-exchange water softener (confirmed by hardness test >7 GPG)"
        ],
        [
          "Scale only, no sodium concern",
          "TAC template crystallization (Nuvo, SoftPro TAC)"
        ],
        [
          "Chlorine taste and odor",
          "Whole-house GAC filter or under-sink carbon block"
        ],
        [
          "Nitrates in well water (infants)",
          "Under-sink RO system"
        ],
        [
          "Lead concern, old home",
          "NSF/ANSI 53 certified point-of-use filter for lead"
        ],
        [
          "Coliform bacteria in well",
          "UV disinfection (Class A, post-sediment/carbon filter)"
        ],
        [
          "Complete chemical reduction at tap",
          "Under-sink RO + post-carbon + remineralization"
        ],
        [
          "Iron staining from well",
          "Iron removal filter (Birm, Greensand) + pre-oxidation"
        ],
        [
          "Arsenic in well water",
          "RO or activated alumina filter"
        ]
      ]
    }
  ]
