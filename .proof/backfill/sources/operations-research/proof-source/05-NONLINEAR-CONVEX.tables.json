      "heading_context": "## Layer 3: Lagrangian Duality (the unifying frame)",
      "headers": [
        "Problem class",
        "Duality gap"
      ],
      "rows": [
        [
          "LP (feasible, finite)",
          "Zero (no CQ needed)"
        ],
        [
          "Convex + Slater",
          "Zero"
        ],
        [
          "Convex, Slater fails",
          "May be positive"
        ],
        [
          "Nonconvex",
          "Generally positive"
        ]
      ]
    },
