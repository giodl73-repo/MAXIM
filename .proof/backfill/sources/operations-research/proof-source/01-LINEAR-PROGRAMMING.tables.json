      "headers": [
        "Method",
        "Idea"
      ],
      "rows": [
        [
          "**Two-phase simplex**",
          "Phase I: add artificial vars, minimize their sum; if min = 0, drop them and a feasible vertex is found. Phase II: optimize the real objective."
        ],
        [
          "**Big-M method**",
          "Penalize artificial vars with a huge cost $M$ in a single combined objective."
        ]
      ]
