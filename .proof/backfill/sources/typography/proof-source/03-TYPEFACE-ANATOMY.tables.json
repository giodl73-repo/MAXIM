          "X-height",
          "Height of lowercase letters (the 'x')",
          "Primary legibility predictor at small sizes"
        ],
        [
          "Baseline",
          "Reference line letters sit on",
          "Coordinate origin for all metrics"
        ],
        [
          "Ascender",
          "Portion above x-height (b, d, f, h, k, l)",
          "Affects line-height/leading calculation"
        ],
        [
          "Descender",
          "Portion below baseline (g, j, p, q, y)",
          "Affects line-height/leading calculation"
        ],
        [
          "Em",
          "Square equal to type size",
          "Relative unit; 1em in CSS = parent font size"
        ],
        [
          "Counter",
          "Interior space of letters",
          "Too-small counter = hard to read at low res"
        ],
        [
          "Stroke contrast",
          "Thick/thin ratio",
          "Low = modern/sans; high = classical/Didone"
        ],
        [
          "Stress axis",
          "Angle of thinnest stroke",
          "Diagonal = humanist/calligraphic; vertical = rational/modern"
        ],
        [
          "Serif",
          "Small perpendicular foot at stroke end",
          "Presence/absence = serif vs sans distinction"
        ],
        [
          "Overshoot",
          "Round letters slightly exceed cap height",
          "Optical correction for equal apparent size"
        ],
