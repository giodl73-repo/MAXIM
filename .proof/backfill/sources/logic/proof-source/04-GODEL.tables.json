      "rows": [
        [
          "What does G1 say?",
          "Every consistent, recursively axiomatizable, sufficiently strong T is incomplete."
        ],
        [
          "What does G2 say?",
          "Such T cannot prove Con(T)."
        ],
        [
          "What's the Gödel sentence?",
          "G <-> neg Provable(gn(G)): \"I am not provable.\""
        ],
        [
          "What is Gödel numbering?",
          "Encoding formulas/proofs as natural numbers."
        ],
        [
          "Can G be proved in a stronger system?",
          "Yes — G is provable in T + Con(T)."
        ],
        [
          "Does G2 prove PA is inconsistent?",
          "No — it says PA cannot prove its own consistency."
        ],
        [
          "What is Tarski undefinability?",
          "No formula in PA can serve as its own truth predicate."
        ],
        [
          "What is Löb's theorem?",
          "T \\|- Box phi -> phi only when T \\|- phi."
        ]
      ]
