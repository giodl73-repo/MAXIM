      "heading_context": "## Decision Cheat Sheet",
      "headers": [
        "I want to...",
        "Use"
      ],
      "rows": [
        [
          "Express \"every x has a property\"",
          "Forall x. P(x)"
        ],
        [
          "Express \"some x has a property\"",
          "Exists x. P(x)"
        ],
        [
          "Negate a universal",
          "neg Forall x. phi  ===  Exists x. neg phi"
        ],
        [
          "Negate an existential",
          "neg Exists x. phi  ===  Forall x. neg phi"
        ],
        [
          "Eliminate Exists for resolution",
          "Skolemization"
        ],
        [
          "Make two terms match by substitution",
          "Unification (Robinson's algorithm)"
        ],
        [
          "Check satisfiability of ground formula",
          "Herbrand lifting -> propositional SAT"
        ],
        [
          "Decide arithmetic without multiplication",
          "Presburger arithmetic decision procedure"
        ],
        [
          "Decide real polynomial arithmetic",
          "Tarski's quantifier elimination (CAD algorithm)"
        ]
      ]
    }
