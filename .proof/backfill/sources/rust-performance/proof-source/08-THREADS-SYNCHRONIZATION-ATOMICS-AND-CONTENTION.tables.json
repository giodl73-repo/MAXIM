      "heading_context": "## Atomics and Memory Ordering",
      "headers": [
        "Ordering",
        "Broad intent",
        "Caution"
      ],
      "rows": [
        [
          "`Relaxed`",
          "Atomicity only; counters where ordering is irrelevant",
          "Does not publish other memory"
        ],
        [
          "`Acquire`",
          "Observe writes released before a synchronization event",
          "Usually paired with release operation"
        ],
        [
          "`Release`",
          "Publish prior writes before an event",
          "Does not constrain later reads like seq-cst"
        ],
        [
          "`AcqRel`",
          "Read-modify-write with both roles",
          "Protocol still needs proof"
        ],
        [
          "`SeqCst`",
          "Single global order among seq-cst operations",
          "Stronger/easier to reason about, sometimes costlier"
        ]
      ]
    },
