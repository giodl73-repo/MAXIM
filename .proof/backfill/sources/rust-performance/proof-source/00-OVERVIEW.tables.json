      "heading_context": "## Four Questions Before Any Optimization",
      "headers": [
        "Question",
        "Required answer"
      ],
      "rows": [
        [
          "What outcome matters?",
          "p99 latency, sustained throughput, RSS, binary size, build time, cloud cost, or another explicit metric"
        ],
        [
          "Under what workload?",
          "Input distribution, concurrency, data size, warm/cold state, target, and dependency versions"
        ],
        [
          "Compared with what?",
          "A preserved baseline built and run under the same contract"
        ],
        [
          "How will causality be checked?",
          "Profile, counter, trace, allocation record, or controlled experiment"
        ]
      ]
    },
