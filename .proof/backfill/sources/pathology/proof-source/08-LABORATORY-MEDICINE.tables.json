      "line": 388,
      "heading_context": "## 4. Analytical vs Clinical Sensitivity/Specificity — The Central Confusion",
      "headers": [
        "Term",
        "Belongs to",
        "Definition",
        "Fails when…"
      ],
      "rows": [
        [
          "Analytical sensitivity",
          "The assay",
          "Smallest reliably detected amount / response slope",
          "It is conflated with disease detection"
        ],
        [
          "Analytical specificity",
          "The assay",
          "Measures only the measurand (selectivity)",
          "An interferent or cross-reactant is present"
        ],
        [
          "Clinical sensitivity",
          "A threshold + population",
          "P(pos \\| disease)",
          "Applied without prevalence/spectrum context"
        ],
        [
          "Clinical specificity",
          "A threshold + population",
          "P(neg \\| no disease)",
          "Spectrum shifts across populations"
        ]
      ]
