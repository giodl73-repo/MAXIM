          "Repeated QC over time",
          "Jitter / variance"
        ],
        [
          "Bias (trueness)",
          "Systematic offset",
          "Reference method / EQA",
          "Clock skew / constant offset"
        ],
        [
          "TEcalc (calculated total error)",
          "Worst plausible single-result error of the method",
          "bias + z·SD (abs) or bias% + z·CV% (percent)",
          "Measured error"
        ],
        [
          "TEa (allowable total error)",
