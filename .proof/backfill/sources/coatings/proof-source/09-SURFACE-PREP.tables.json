  "tables": [
    {
      "id": "table-1",
      "line": 474,
      "heading_context": "## Decision Cheat Sheet",
      "headers": [
        "Surface / Situation",
        "Prep Required"
      ],
      "rows": [
        [
          "New drywall, interior",
          "TSP wash, fill holes, PVA primer"
        ],
        [
          "Previously painted wall, clean",
          "Wash with TSP solution"
        ],
        [
          "Previously painted wall, stained",
          "TSP wash + stain identification + correct primer"
        ],
        [
          "Bare wood, smooth (furniture)",
          "80-120-150-180-220 sanding progression"
        ],
        [
          "Bare wood, exterior",
          "Sand to 120, remove resin/mill glaze, oil primer"
        ],
        [
          "Knotty pine",
          "Shellac BIN over knots, 2 coats"
        ],
        [
          "Bare steel, shop/industrial",
          "SP1 solvent clean → SP6 blast (minimum)"
        ],
        [
          "Steel in aggressive environment",
          "SP1 → SP10 blast → zinc-rich primer"
        ],
        [
          "Galvanized steel",
          "Acid etch primer or SSPC SP16 (sweep blast)"
        ],
        [
          "Aluminum",
          "Scotch-brite + solvent wipe, or etch primer"
        ],
        [
          "Concrete floor (epoxy)",
          "Degreaser → acid etch → rinse → neutralize → moisture test"
        ],
        [
          "New concrete (any coating)",
          "28-day cure, pH test, moisture test"
        ],
        [
          "Old glossy paint",
          "Degloss sand (120-150) or bonding primer"
        ],
        [
          "Tile/slick surface",
          "Bonding primer + scuff sand"
        ],
        [
          "Smoke-damaged drywall",
          "TSP wash → 2 coats shellac BIN"
        ]
      ]
    }
  ]
}