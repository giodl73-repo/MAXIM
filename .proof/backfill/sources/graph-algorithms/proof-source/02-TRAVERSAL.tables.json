      "headers": [
        "Goal",
        "Use",
        "Why"
      ],
      "rows": [
        [
          "Fewest-edges path (unweighted)",
          "BFS",
          "layers = distances"
        ],
        [
          "Any path / reachability",
          "BFS or DFS",
          "both O(V+E)"
        ],
        [
          "Build / dependency order",
          "topological sort",
          "edges = prerequisites"
        ],
        [
          "Detect a cycle (directed)",
          "DFS, gray-vertex back edge",
          "distinguishes back from fwd/cross"
        ],
        [
          "Detect a cycle (undirected)",
          "DFS non-parent visited, or union-find",
          "exclude the parent edge"
        ],
