      "heading_context": "## Cycle Detection — Different Rules for Directed vs Undirected",
      "headers": [
        "Graph class",
        "Detection rule",
        "Pitfall"
      ],
      "rows": [
        [
          "Directed",
          "DFS back edge to a **gray** (on-stack) vertex",
          "a black vertex is NOT a cycle"
        ],
        [
          "Undirected",
          "DFS edge to any visited **non-parent** vertex",
          "forgetting to exclude the parent edge ⇒ false positive"
        ],
        [
          "Undirected (incremental)",
          "union-find: endpoints already unioned",
          "—"
        ]
      ]
