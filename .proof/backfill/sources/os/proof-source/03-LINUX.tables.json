      "headers": [
        "Namespace",
        "Flag",
        "Isolates",
        "Example impact"
      ],
      "rows": [
        [
          "pid",
          "CLONE_NEWPID",
          "Process ID numbers",
          "Container's process is PID 1, not 47382"
        ],
        [
          "net",
          "CLONE_NEWNET",
          "Network interfaces, routing, firewall rules",
          "Container has its own eth0, 172.17.0.x"
        ],
        [
          "mnt",
          "CLONE_NEWNS",
          "Filesystem mount points",
          "Container sees its image as /"
        ],
        [
          "uts",
          "CLONE_NEWUTS",
