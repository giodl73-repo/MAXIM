      "heading_context": "## 1. iOS Architecture",
      "headers": [
        "Feature",
        "macOS",
        "iOS"
      ],
      "rows": [
        [
          "`fork()`",
          "Yes (POSIX)",
          "No — not allowed in sandboxed apps"
        ],
        [
          "`exec()`",
          "Yes",
          "No"
        ],
        [
          "JIT compilation",
          "Yes (with entitlement)",
          "No (prior to iOS 14.2); restricted even now"
        ],
        [
          "Multiple user accounts",
          "Yes",
          "No (single user; enterprise managed)"
        ],
        [
          "Unsigned code execution",
          "Yes (without SIP)",
          "Never — all code must be signed"
        ],
        [
          "Dynamic library loading",
          "Yes (developer dylibs)",
          "No — only system dylibs; app frameworks must be embedded"
        ],
        [
          "Terminal / shell access",
          "Yes",
          "No"
        ],
        [
          "Sandbox",
          "Optional (App Store only)",
          "Mandatory — every app, always"
        ],
        [
          "GUI customization",
          "Menubar, Dock, etc.",
          "Fixed: SpringBoard controls all"
        ]
      ]
    },
