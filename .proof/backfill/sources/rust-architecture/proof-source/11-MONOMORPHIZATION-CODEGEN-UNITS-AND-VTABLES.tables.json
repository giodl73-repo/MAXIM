      "headers": [
        "Question",
        "Current answer"
      ],
      "rows": [
        [
          "Does rustc currently share generic instances through polymorphization?",
          "No"
        ],
        [
          "Should architecture or size estimates assume it?",
          "No; reason from ordinary monomorphization"
        ],
        [
          "Can identical native code still be folded?",
          "A backend or linker may perform identical-code folding, but that is separate, target-dependent machinery"
        ]
