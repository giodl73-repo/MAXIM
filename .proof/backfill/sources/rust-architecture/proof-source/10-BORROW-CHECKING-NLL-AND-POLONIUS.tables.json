      "headers": [
        "Mechanism",
        "Purpose",
        "Example"
      ],
      "rows": [
        [
          "Shared loan",
          "Allows reads, blocks conflicting mutation",
          "`let r = &v;`"
        ],
        [
          "Mutable loan",
          "Exclusive access once active",
          "`let r = &mut v;`"
        ],
        [
          "Two-phase borrow",
          "Permits reservation before evaluating arguments",
          "`v.push(v.len())`"
        ],
        [
          "Move path",
          "Tracks ownership transfer at place granularity",
          "`let y = x; use(x)` is E0382"
        ],
        [
          "Drop interaction",
          "Keeps destructor paths sound after moves",
