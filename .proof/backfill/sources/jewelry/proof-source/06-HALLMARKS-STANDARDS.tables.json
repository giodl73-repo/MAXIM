      "headers": [
        "Standard",
        "Scope",
        "Notes"
      ],
      "rows": [
        [
          "**RJC (Responsible Jewellery Council)**",
          "Mining through retail; full supply chain",
          "Covers human rights, labor, environment, ethics"
        ],
        [
          "**Fairtrade Gold**",
          "Artisanal/small-scale mining",
          "Certified mines, premium paid to miners, few licensed mines"
        ],
        [
          "**Fairmined Gold**",
          "Artisanal/small-scale mining",
          "Independent certification; ASM focus"
        ],
        [
          "**Recycled Gold**",
          "Post-consumer metal",
          "No new mining; origin of original mining unverified"
        ],
        [
          "**Alliance for Responsible Mining**",
          "Small-scale mining",
          "Capacity building in source communities"
        ]
      ]
