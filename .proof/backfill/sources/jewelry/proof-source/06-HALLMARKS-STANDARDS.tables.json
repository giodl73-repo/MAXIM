      "heading_context": "## Decision Cheat Sheet",
      "headers": [
        "Situation",
        "What to Look For"
      ],
      "rows": [
        [
          "Buying in UK",
          "Look for full 4-mark hallmark from assay office"
        ],
        [
          "Buying in US",
          "FTC quality stamps + maker's trademark; buy from reputable retailers"
        ],
        [
          "Importing to EU",
          "Check CCM or national assay marks"
        ],
        [
          "Diamond purchase",
          "GIA Grading Report (verify report number at gia.edu)"
        ],
        [
          "Ruby/sapphire purchase",
          "AGL, GIA, or Gübelin colored stone report"
        ],
        [
          "Emerald purchase",
          "Report stating oil treatment grade"
        ],
        [
          "High-value antique",
          "Specialist appraisal + hallmark identification guide"
        ],
        [
          "Sustainability concern",
          "RJC certification or Fairtrade/Fairmined gold"
        ],
        [
          "Conflict diamond concern",
          "Kimberley Process (limited); or choose lab-grown"
        ]
      ]
    }
