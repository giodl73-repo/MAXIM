      "id": "table-2",
      "line": 165,
      "heading_context": "## European and International Systems",
      "headers": [
        "Country/Region",
        "System",
        "Notes"
      ],
      "rows": [
        [
          "**Italy**",
          "Mandatory state hallmarks + maker's mark",
          "Gold mostly 750 (18k); fineness in geometric frame; provincial assay marks historically"
        ],
        [
          "**France**",
          "Mandatory; eagle's head (18k Au), owl (imported); French tradition extensive",
          "Different marks for domestic vs import"
        ],
        [
          "**Germany**",
          "No state hallmarks (voluntary); Lotmarke for 18k+",
          "Self-declaration with maker's mark"
        ],
        [
          "**Switzerland**",
          "Complex; federal and cantonal marks; watch industry extensive",
          "Swan = 18k gold; key historical watch marks"
        ],
        [
          "**Russia / USSR**",
          "5-pointed star (Soviet) or kokoshnik (woman's headdress) after 1994",
          "Numbers after mark indicate fineness (585, 750, 925)"
        ],
        [
          "**Turkey**",
          "Mandatory; crescent and star marks",
          "Active international exporter"
        ],
        [
          "**India**",
          "BIS Hallmarking (Bureau of Indian Standards); mandatory since 2021 for major cities",
          "Three-mark system: BIS logo + purity + assay office"
        ],
        [
          "**China**",
          "Not mandatory in same sense; State stamps on official items",
          "\"G18K\" = 750 fineness gold"
        ]
      ]
    },
