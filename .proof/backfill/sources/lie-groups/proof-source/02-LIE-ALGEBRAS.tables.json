      "heading_context": "## The Exponential Map",
      "headers": [
        "Property",
        "Formula",
        "Notes"
      ],
      "rows": [
        [
          "exp(0) = I",
          "",
          "Base point is identity"
        ],
        [
          "exp(X)^{-1} = exp(-X)",
          "",
          "Inverse"
        ],
        [
          "det(exp(X)) = exp(tr(X))",
          "",
          "Crucial for SL and SU"
        ],
        [
          "exp(A X A^{-1}) = A exp(X) A^{-1}",
          "",
          "Equivariance"
        ],
        [
          "exp((s+t)X) = exp(sX)exp(tX)",
          "",
          "One-parameter subgroup"
        ],
        [
          "exp(X+Y) = exp(X)exp(Y) IF [X,Y]=0",
          "",
          "Commuting case only"
        ]
      ]
    },
    {
      "id": "table-2",
      "line": 292,
      "heading_context": "## Decision Cheat Sheet",
      "headers": [
        "If you need to diagnose...",
        "Start With",
        "Key Caveat"
      ],
      "rows": [
        [
          "Lie algebra of a group",
          "Tangent space at identity `T_e G`",
          "Determines local structure, not global topology of `G`."
        ],
        [
          "Non-commutativity",
          "Bracket `[X,Y]`, matrix commutator for matrix groups",
          "Abstract Lie brackets need not be presented as matrices."
        ],
        [
          "Exponential map",
          "`exp: g -> G` from infinitesimal to finite transformations",
          "Not globally surjective for many non-compact groups."
        ],
        [
          "One-parameter subgroups",
          "`phi_X(t) = exp(tX)`",
          "Captures flows generated by one algebra element only."
        ],
        [
          "BCH multiplication",
          "`log(exp(X)exp(Y)) = X + Y + 1/2[X,Y] + ...`",
          "Converges locally near zero, not as a global multiplication chart."
        ],
        [
          "Adjoint representation",
          "Conjugation action `Ad_g(X) = gXg^{-1}`",
          "Differentiating gives `ad_X(Y) = [X,Y]`."
        ],
        [
          "Semisimplicity test",
          "Killing form `B(X,Y) = tr(ad_X ad_Y)`",
          "Nondegenerate means semisimple; simple is stronger."
        ]
      ]
    }
  ]
