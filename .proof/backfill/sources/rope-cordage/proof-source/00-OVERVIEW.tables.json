      "heading_context": "## Decision Cheat Sheet",
      "headers": [
        "Situation",
        "Rope Choice"
      ],
      "rows": [
        [
          "Dynamic climbing (fall arrest)",
          "Nylon kernmantle, UIAA-certified dynamic"
        ],
        [
          "Static rigging, minimal stretch",
          "Polyester double-braid or Dyneema"
        ],
        [
          "Mooring lines (absorb surge)",
          "Nylon — high elongation by design"
        ],
        [
          "Life safety rescue",
          "Low-elongation polyester kernmantle, NFPA 1983 compliant"
        ],
        [
          "Weight-critical application",
          "UHMWPE (Dyneema/Spectra) — highest strength-to-weight"
        ],
        [
          "High-temperature environment",
          "Aramid (Kevlar/Technora) — stable to 480°C dry"
        ],
        [
          "Budget light-duty use",
          "Polypropylene — cheap, floats; accept UV degradation"
        ],
        [
          "Racing yacht standing rigging",
          "Dyneema or Vectran (low creep, low stretch)"
        ]
      ]
    }
