          "`WITH (NOLOCK)` for fast dirty reads",
          "READ UNCOMMITTED (its hazards)",
          "`NOLOCK`, READ UNCOMMITTED"
        ],
        [
          "The default that \"just reads committed rows\"",
          "READ COMMITTED (per-statement snapshot)",
          "Default level; RCSI variant"
        ],
        [
          "Optimistic concurrency with `rowversion`",
          "Lost-update prevention",
          "`WHERE rowver=@old`, SNAPSHOT"
        ],
