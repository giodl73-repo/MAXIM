      "line": 205,
      "heading_context": "## Conflict resolution (multi-leader / leaderless)",
      "headers": [
        "Strategy",
        "Mechanism",
        "Trade-off"
      ],
      "rows": [
        [
          "**Last-write-wins (LWW)**",
          "Keep the write with the highest timestamp",
          "Simple; **silently drops** the loser's write; clock skew hazard"
        ],
        [
          "**Version vectors**",
          "Track per-replica version counters; detect concurrent vs causal",
          "Detects true conflicts; needs app-level merge"
        ],
        [
          "**CRDTs**",
          "Conflict-free replicated data types: merges are commutative/associative/idempotent by construction",
          "No coordination needed; limited to CRDT-expressible types"
        ],
        [
          "**Application merge**",
          "Surface both versions (siblings); app decides (e.g. shopping-cart union)",
          "Correct; pushes work to the app"
        ]
      ]
    },
