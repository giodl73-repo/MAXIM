    {
      "id": "table-3",
      "line": 232,
      "heading_context": "## Decision Cheat Sheet",
      "headers": [
        "Need",
        "Choice"
      ],
      "rows": [
        [
          "No data loss on failover",
          "**Synchronous** (or semi-sync) replication to >=1 follower"
        ],
        [
          "Lowest write latency, tolerate small loss window",
          "**Asynchronous** replication"
        ],
        [
          "Read scaling",
          "Async **followers**; route reads off the leader"
        ],
        [
          "Read-your-writes after a write",
          "Route to leader briefly, or read a replica at >= the write's LSN"
        ],
        [
          "Multi-region writes (active-active)",
          "**Multi-leader** + a real conflict policy (not naive LWW)"
        ],
        [
          "Maximum availability, accept eventual consistency",
          "**Leaderless quorum** (Dynamo-style), tune W/R"
        ],
        [
          "Automatic failover safely",
          "Single-leader + **fencing/consensus** to prevent split-brain"
        ],
        [
          "Replica drifting from primary",
          "Use **row-based** logical replication, not statement-based"
        ]
      ]
    }
  ]
