        "Dynamic Interpretation"
      ],
      "rows": [
        [
          "Wind flowing parallel to isobars",
          "Geostrophic balance (above ABL)"
        ],
        [
          "Wind crossing isobars toward low",
          "Friction (in boundary layer) or ageostrophic forcing"
        ],
        [
          "Strong ridge–trough pattern aloft",
          "Rossby wave pattern; look for associated surface systems"
        ],
        [
          "Upper-level trough approaching surface low",
          "Divergence aloft → surface cyclone intensification"
        ],
        [
          "Jet streak left exit region",
          "Divergence → rising motion → convection favored"
        ],
        [
          "Temperature inversely related to height → strong capping",
          "Stable layer; suppresses convection"
        ]
