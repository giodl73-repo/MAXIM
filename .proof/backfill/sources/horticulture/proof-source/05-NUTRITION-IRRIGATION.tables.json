      "headers": [
        "Nutrient",
        "Primary Function",
        "Deficiency Symptom",
        "Notes"
      ],
      "rows": [
        [
          "Calcium (Ca)",
          "Cell wall structure, membrane integrity",
          "Blossom end rot (tomato), tip burn (lettuce), bitter pit (apple)",
          "Immobile in plant — deficiency appears in youngest tissue; caused by water stress even when Ca present in soil"
        ],
        [
          "Magnesium (Mg)",
          "Chlorophyll center atom, enzyme activator",
          "Interveinal chlorosis on older leaves (Mg mobile)",
          "Easily leached in sandy soils; corrected with Epsom salt (MgSO₄)"
        ],
        [
          "Sulfur (S)",
          "Amino acids (methionine, cysteine), glucosinolates",
          "Uniform yellowing of young leaves (S immobile)",
          "Usually adequate from atmospheric deposition + organic matter"
        ]
      ]
    },
