        "Soil Problem",
        "Diagnosis",
        "Solution"
      ],
      "rows": [
        [
          "Iron chlorosis (yellow leaves, green veins)",
          "pH >7.0",
          "Acidify soil; apply chelated iron; use acid-tolerant rootstock"
        ],
        [
          "Slow drainage, waterlogging",
          "Clay texture or compaction",
          "Raised beds; drainage tile; organic matter additions over time"
        ],
        [
          "Nutrient leaching after rain",
          "Sandy texture, low CEC",
          "Split fertigation applications; increase SOM"
        ],
        [
          "Container media drying too fast",
          "Low water retention",
          "Add coir or vermiculite; increase irrigation frequency"
        ],
        [
          "Seedling damping-off in containers",
          "Soilborne pathogens",
          "Pasteurize media; reduce overwatering; improve drainage"
        ],
