          "`&[u8]` / `CStr` ([17](17-UNSAFE-RUST-FFI-AND-ABI.md))",
          "No implicit NUL terminator"
        ],
        [
          "`string.Length` (UTF-16 units)",
          "`.len()` (bytes) / `.chars().count()`",
          "Neither equals \"grapheme count\""
        ],
        [
          "`Path.Combine` (.NET)",
          "`Path::join`",
          "Same intent, OS-correct"
        ],
        [
          "`string.Format` / interpolation",
          "`format!` / `{name}`",
          "Trait-driven (`Display`/`Debug`)"
        ]
