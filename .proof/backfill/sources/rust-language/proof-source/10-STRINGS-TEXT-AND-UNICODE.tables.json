        "Rust",
        "Difference"
      ],
      "rows": [
        [
          "C# `string` (UTF-16, indexable)",
          "`String`/`&str` (UTF-8, not indexable)",
          "No `s[i]`; byte vs char explicit"
        ],
        [
          "C# `char` (UTF-16 code unit)",
          "`char` (Unicode scalar, 4 bytes)",
          "Rust `char` holds any scalar; C# `char` is half a surrogate pair"
        ],
