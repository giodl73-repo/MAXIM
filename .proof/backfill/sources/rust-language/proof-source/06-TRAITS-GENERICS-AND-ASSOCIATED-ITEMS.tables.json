      "headers": [
        "I want to...",
        "Use"
      ],
      "rows": [
        [
          "Define shared behavior",
          "a `trait`"
        ],
        [
          "Provide reusable logic on required methods",
          "default methods"
        ],
        [
          "One output type per implementer",
          "associated type (`type Item;`)"
        ],
        [
          "Many impls with different inputs",
          "generic trait param (`From<T>`)"
        ],
        [
          "Constrain a generic",
          "bound: `<T: Trait>` or `where T: Trait`"
        ],
