      "heading_context": "## Decision Cheat Sheet",
      "headers": [
        "Situation",
        "Use"
      ],
      "rows": [
        [
          "Value might be absent (no reason)",
          "`Option<T>`"
        ],
        [
          "Operation might fail (with reason)",
          "`Result<T, E>`"
        ],
        [
          "Propagate failure to caller",
          "`?`"
        ],
        [
          "Handle Ok/Err differently here",
          "`match` / `if let`"
        ],
        [
          "Provide a default on absence/failure",
          "`unwrap_or` / `unwrap_or_else` / `unwrap_or_default`"
        ],
        [
          "Convert `Option` <-> `Result`",
          "`ok_or` / `.ok()`"
        ],
        [
          "Define a library error type",
          "`thiserror` derive"
        ],
        [
          "Handle errors in an app/binary",
          "`anyhow::Result` + `.context()`"
        ],
        [
          "No-dependency dynamic error",
          "`Box<dyn Error + Send + Sync>`"
        ],
        [
          "Signal a broken invariant / bug",
          "`panic!` / `assert!` / `expect`"
        ],
        [
          "Catch a panic at an FFI/test edge",
          "`std::panic::catch_unwind` (not as flow control)"
        ]
