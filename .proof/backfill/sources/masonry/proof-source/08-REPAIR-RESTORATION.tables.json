        [
          "Failed mortar joints, pre-1900 brick",
          "Petrographic analysis → NHL or lime putty repoint"
        ],
        [
          "Failed mortar joints, post-1950 CMU",
          "Match original — typically Type S"
        ],
        [
          "Stair-step diagonal cracks",
          "Monitor for movement first; address foundation then repoint"
        ],
        [
          "Horizontal crack above window",
          "Investigate corroded lintel or flashing; replace metal first"
        ],
        [
          "Efflorescence, new building",
          "Watch 1–2 years; likely primary; fix moisture entry points"
        ],
        [
          "Efflorescence, recurring",
          "Investigate source; do not seal surface"
        ],
        [
          "Atmospheric dirt cleaning",
          "Low-pressure wash first; acidic/alkaline chemical if needed"
        ],
        [
          "Post-earthquake crack assessment",
          "Document pattern; consult structural engineer before repair"
        ]
