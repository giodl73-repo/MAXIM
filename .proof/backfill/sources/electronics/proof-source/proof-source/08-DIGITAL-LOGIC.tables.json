      "headers": [
        "Law",
        "OR form",
        "AND form"
      ],
      "rows": [
        [
          "Identity",
          "A + 0 = A",
          "A · 1 = A"
        ],
        [
          "Null",
          "A + 1 = 1",
          "A · 0 = 0"
        ],
        [
          "Idempotent",
          "A + A = A",
          "A · A = A"
        ],
        [
          "Complement",
          "A + Ā = 1",
          "A · Ā = 0"
        ],
        [
          "Double negation",
          "—",
          "Ā̄ = A"
        ],
        [
          "Commutative",
          "A+B = B+A",
          "AB = BA"
        ],
        [
          "Associative",
          "A+(B+C) = (A+B)+C",
          "A(BC) = (AB)C"
        ],
        [
          "Distributive",
          "A(B+C) = AB+AC",
          "A+BC = (A+B)(A+C)"
        ],
        [
          "Absorption",
          "A + AB = A",
          "A(A+B) = A"
        ],
        [
          "**De Morgan**",
          "**(A+B)̄ = Ā·B̄**",
          "**(AB)̄ = Ā+B̄**"
        ],
        [
          "Consensus",
          "AB + ĀC + BC = AB + ĀC",
          "(A+B)(Ā+C)(B+C) = (A+B)(Ā+C)"
        ]
      ]
