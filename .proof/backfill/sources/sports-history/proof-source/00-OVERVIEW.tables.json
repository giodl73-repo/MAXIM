      "headers": [
        "Factor",
        "Effect",
        "Examples"
      ],
      "rows": [
        [
          "Altitude >2000m",
          "Reduced O2 -> lower aerobic performance initially; hematological adaptation (higher EPO, hematocrit) long-term",
          "Mexico City 1968: sprints OK, distance events suffer acutely"
        ],
        [
          "Heat + humidity",
          "Core temperature rise, cardiovascular strain (blood to skin for cooling vs muscles)",
          "Tokyo 2020/2021: scheduling to morning; Qatar 2022: air-conditioned stadiums"
        ],
        [
          "Humidity alone",
          "Reduces evaporative cooling efficiency; WBGT > dry bulb for performance assessment",
          "Used in F1, athletics for heat protocols"
        ],
        [
          "Legal tailwind limit",
          "Records invalid above 2.0 m/s assist for sprints/jumps",
          "Ben Johnson 1988: +1.1 m/s legal assist"
        ],
        [
          "Altitude + cold",
          "Reduced respiratory capacity; pulmonary edema risk",
          "Nordic skiing, Himalayan mountaineering"
        ]
      ]
