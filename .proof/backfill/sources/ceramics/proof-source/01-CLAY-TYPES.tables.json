          "**Bentonite**",
          "Sodium smectite; extremely fine platelets; swells in water",
          "1–3% addition dramatically increases plasticity"
        ],
        [
          "**Paper clay**",
          "Clay + cellulose paper fiber",
          "Reduces cracking; joins wet-to-dry; sculpture"
        ],
        [
          "**Terracotta**",
          "Iron-rich earthenware; red/orange in oxidation",
          "Pots, figures, tiles, bricks"
        ],
        [
          "**Raku body**",
          "High-grog content",
          "Thermal shock resistance (rapid heating/cooling)"
        ],
        [
          "**Colored slips**",
          "Clay + oxides (slip)",
          "Surface coloration; slip trailing; sgraffito"
        ],
        [
          "**Terra sigillata**",
          "Extremely fine deflocculated slip; burnished",
          "Roman red/black gloss ware technique"
        ],
        [
          "**Cordierite**",
          "Magnesium iron silicate mineral (not clay)",
          "Kiln furniture; exceptional thermal shock resistance"
        ]
      ]
