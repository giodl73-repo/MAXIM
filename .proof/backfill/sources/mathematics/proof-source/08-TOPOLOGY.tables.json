          "What's the fundamental group of a circle?",
          "ℤ (winding number)"
        ],
        [
          "What's the fundamental group of a torus?",
          "ℤ × ℤ"
        ],
        [
          "Is the sphere S² simply connected?",
          "Yes — π₁(S²) = {e}"
        ],
