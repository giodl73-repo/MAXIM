          "Gaussian → Gaussian"
        ],
        [
          "rect(t)",
          "sinc(ω/2) = sin(ω/2)/(ω/2)",
          "Box → sinc"
        ],
        [
          "sinc(t)",
          "π·rect(ω/2)",
          "Sinc → box"
        ],
        [
          "cos(ω₀t)",
          "π[δ(ω-ω₀) + δ(ω+ω₀)]",
          "Cosine → two spikes"
        ],
        [
          "sin(ω₀t)",
          "iπ[δ(ω+ω₀) - δ(ω-ω₀)]",
          "Sine → two spikes"
        ],
        [
          "e^(iω₀t)",
          "2πδ(ω-ω₀)",
          "Complex exponential → spike"
        ],
        [
          "Σ δ(t-nT)",
          "(2π/T)Σ δ(ω-2πk/T)",
          "Dirac comb → Dirac comb"
        ]
      ]
