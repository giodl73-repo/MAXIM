        ],
        [
          "1",
          "2πδ(ω)",
          "DC → impulse at ω=0"
        ],
        [
          "e^(-at)u(t), a>0",
          "1/(a+iω)",
          "Decaying exponential"
        ],
        [
          "e^(-a\\|t\\|)",
          "2a/(a²+ω²)",
          "Two-sided exponential"
        ],
        [
          "e^(-t²/2)",
