          "Real JSON/CSV -> jq / csvkit"
        ],
        [
          "Sum/count/average a column",
          "Multi-file joins > 2 files -> Python"
        ],
        [
          "Quick frequency table",
          "Need arrays of arrays -> Python"
        ],
        [
          "One-liner faster than a script",
          "Need libraries/HTTP/DB -> anything else"
        ],
        [
          "On any Unix box (always available)",
          "Maintaining readable code -> Python"
        ],
        [
