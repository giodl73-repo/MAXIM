        [
          "Why borosilicate survives oven heat",
          "Low CTE → small thermal stress"
        ],
        [
          "Why lead crystal sparkles",
          "High PbO → high RI and dispersion"
        ],
        [
          "Why glass in UV darkens (solarization)",
          "Fe²⁺ and other redox from UV"
        ],
        [
          "Why decanters shouldn't store port",
          "Pb leaches into acidic alcohol"
        ],
        [
          "Why fused silica for chip fabrication",
          "Withstands >1,000°C; ultra-pure; UV-transparent"
        ],
        [
          "Why glass is transparent",
          "Gap between UV electronic and IR phonon absorption"
        ],
        [
          "CTE mismatch: glass fusing",
          "Must be within ~0.5×10⁻⁶/°C or seal fails"
        ],
        [
          "Why annealing prevents spontaneous fracture",
          "Relieves residual thermal stress below strain point"
        ]
