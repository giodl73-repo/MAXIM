      ],
      "rows": [
        [
          "Who invented paper?",
          "Cai Lun (105 CE) systematized it; earlier experiments exist"
        ],
        [
          "How did it reach Europe?",
          "Via Islamic world after Battle of Talas (751)"
        ],
        [
          "What was European paper made from?",
          "Linen and cotton rags until ~1840s"
        ],
        [
          "What drives the rag crisis?",
          "Gutenberg + printing press multiplication of demand"
        ],
        [
          "Who invented the continuous machine?",
          "Robert (1798 patent), Fourdrinier/Donkin (1807 commercial)"
        ],
        [
          "What made kraft dominant?",
          "Chemical recovery economics + fiber strength (Dahl, 1884)"
        ],
        [
          "When did acid-free paper arrive?",
          "Alkaline sizing widespread from late 1980s"
        ]
      ]
    }
