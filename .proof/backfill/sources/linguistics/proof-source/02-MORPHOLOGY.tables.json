      "headers": [
        "Morphological type",
        "Parsing strategy",
        "Analogy"
      ],
      "rows": [
        [
          "Isolating (Mandarin)",
          "No morphology needed; tokenize on whitespace",
          "Keywords only; no compound tokens"
        ],
        [
          "Agglutinative (Turkish)",
          "Stack-based FST; strip suffix stack left-to-right",
          "Left-recursive grammar; each suffix = one rule application"
        ],
        [
          "Fusional (Latin, Russian)",
          "Paradigm table lookup; can't decompose further",
          "Overloaded operators; one token encodes multiple semantic dimensions"
        ],
        [
          "Polysynthetic (Mohawk)",
          "Full clause parser required to analyze one \"word\"",
          "Macro expansion; a single token expands to a full AST"
        ]
      ]
