      ],
      "rows": [
        [
          "\"The morning star = the evening star\"",
          "Sense ≠ reference",
          "Fregean sense/Bedeutung"
        ],
        [
          "\"Every student read some book\" (ambiguous)",
          "Quantifier scope",
          "QR in LF, two derivations"
        ],
        [
          "\"John knows that Mary left\" → \"Mary left\" even when negated",
          "Presupposition (factive)",
          "Presupposition trigger"
        ],
        [
          "\"Some students passed\" ⇝ \"not all\"",
          "Quantity implicature",
          "Gricean maxims"
        ],
        [
          "\"Robin is a better example of bird than ostrich\"",
          "Prototype effects",
          "Typicality gradient"
        ],
        [
          "\"The cat\" refers to a specific cat",
          "Definite description",
          "Russell's ιx operator"
        ],
        [
          "\"John admires himself\" — who does \"himself\" refer to?",
          "Binding + semantics",
          "Anaphora resolution"
        ],
        [
          "\"dog\" means what?",
          "Lexical semantics",
          "Extension = set of dogs; Intension = λw.{x \\| dog(x) in w}"
