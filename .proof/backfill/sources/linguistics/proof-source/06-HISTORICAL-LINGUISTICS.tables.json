      "line": 90,
      "heading_context": "## Part II: Types of Language Change",
      "headers": [
        "Type",
        "Description",
        "Example"
      ],
      "rows": [
        [
          "**Lenition**",
          "Weakening of consonants",
          "Latin /p/ → Spanish /b/: capitu → cabeza"
        ],
        [
          "**Fortition**",
          "Strengthening",
          "/w/ → /β/ in Spanish"
        ],
        [
          "**Vowel shift**",
          "Systematic vowel quality change",
          "Great English Vowel Shift (below)"
        ],
        [
          "**Merger**",
          "Two phonemes collapse into one",
          "/ʍ/ (which) merging with /w/ in many dialects"
        ],
        [
          "**Split**",
          "One phoneme becomes two in different environments",
          "Latin /k/ → Italian /k/ or /tʃ/ before front vowel"
        ],
        [
          "**Assimilation**",
          "Sound becomes more like neighbor",
          "Anticipatory: nasal assimilation"
        ],
        [
          "**Dissimilation**",
          "Sound becomes less like neighbor",
          "Latin *anima* → *alma* in Spanish (via dissimilation)"
        ],
        [
          "**Epenthesis**",
          "Sound inserted",
          "Old English *thrum* → Modern English *thumb*"
        ],
        [
          "**Metathesis**",
          "Sounds reordered",
          "Old English *brid* → Modern English *bird*"
        ],
        [
          "**Apocope**",
          "Word-final loss",
          "Latin *amāre* → Spanish *amar* (final -e lost)"
        ]
      ]
    },
