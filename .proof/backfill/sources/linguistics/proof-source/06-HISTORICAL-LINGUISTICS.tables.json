    {
      "id": "table-3",
      "line": 374,
      "heading_context": "## Part VI: Types of Language Change",
      "headers": [
        "Type",
        "Definition",
        "Example"
      ],
      "rows": [
        [
          "**Broadening (generalization)**",
          "Meaning becomes more inclusive",
          "\"dog\" (OE: a specific breed) → all canines"
        ],
        [
          "**Narrowing (specialization)**",
          "Meaning becomes more restricted",
          "\"hound\" (OE: any dog) → hunting dog"
        ],
        [
          "**Amelioration**",
          "Meaning improves",
          "\"knight\" (OE: youth, servant) → noble warrior"
        ],
        [
          "**Pejoration**",
          "Meaning degrades",
          "\"villain\" (OF: farmhand) → scoundrel"
        ],
        [
          "**Metaphorical extension**",
          "Concrete → abstract",
          "\"grasp\" (physical hold) → \"grasp an idea\""
        ],
        [
          "**Bleaching**",
          "Meaning weakens",
          "\"very\" (Latin *verus* = true) → mere intensifier"
        ],
        [
          "**Euphemism treadmill**",
          "Euphemism inherits old word's negative meaning",
          "toilet → restroom → bathroom → lavatory → ..."
        ]
      ]
    },
    {
      "id": "table-4",
      "line": 476,
      "heading_context": "## Decision Cheat Sheet",
      "headers": [
        "Question",
        "Analysis"
      ],
      "rows": [
        [
          "Why does English \"father\" ≠ Latin \"pater\" in initial consonant?",
          "Grimm's Law: PIE *p → PGmc *f"
        ],
        [
          "Why \"brother\" (d) vs \"father\" (th)?",
          "Verner's Law: accent position conditioned voiced/voiceless"
        ],
        [
          "How do we know what PIE sounded like?",
          "Comparative method: find regular correspondences across daughters"
        ],
        [
          "Why do English plurals use -s mostly?",
          "Analogy/leveling from originally plural Latin/French -s"
        ],
        [
          "Why does \"will\" mark future?",
          "Grammaticalization: lexical \"want\" → future marker"
        ],
        [
          "Why do Haitian/Jamaican creoles look similar?",
          "Bioprogram (Bickerton) or substrate convergence"
        ],
        [
          "Why do Romanian/Bulgarian/Albanian share features despite different ancestry?",
          "Balkan Sprachbund — contact-induced convergence"
        ],
        [
          "How did \"villain\" come to mean \"scoundrel\"?",
          "Pejoration: farmhand → person of low moral character"
        ]
      ]
    }
  ]
