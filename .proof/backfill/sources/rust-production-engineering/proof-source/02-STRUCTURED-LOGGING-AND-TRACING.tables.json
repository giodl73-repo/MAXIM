      "headers": [
        "Surface",
        "Use it for",
        "Avoid"
      ],
      "rows": [
        [
          "Event",
          "state transition, decision, failure, notable fact",
          "per-item noise in hot loops"
        ],
        [
          "Span",
          "duration and context of one operation",
          "treating every function call as a span"
        ],
        [
          "Field",
          "stable query dimension or measured value",
          "unbounded payloads and secrets"
        ],
        [
          "Message",
          "concise human explanation",
          "encoding the only copy of key data"
        ]
      ]
