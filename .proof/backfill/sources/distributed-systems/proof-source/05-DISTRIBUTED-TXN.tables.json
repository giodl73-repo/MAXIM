      "headers": [
        "Dimension",
        "2PC",
        "CRDT"
      ],
      "rows": [
        [
          "Atomicity",
          "Yes (all-or-nothing)",
          "No (individual ops)"
        ],
        [
          "Isolation",
          "Yes (locks during txn)",
          "No (concurrent merges)"
        ],
        [
          "Coordination required",
          "Yes (coordinator + participants)",
          "No (commutative merge)"
        ],
        [
          "Available during partition",
          "No (blocked)",
          "Yes (operate independently, merge later)"
        ],
        [
          "Data model",
          "Arbitrary SQL",
          "CRDT-shaped (counters, sets, sequences)"
