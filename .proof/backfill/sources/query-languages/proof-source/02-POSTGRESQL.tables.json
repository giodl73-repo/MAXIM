      "heading_context": "## EXPLAIN ANALYZE",
      "headers": [
        "Field",
        "What it means",
        "Action if wrong"
      ],
      "rows": [
        [
          "`actual rows` vs `rows` estimate",
          "Large gap = stale stats",
          "`ANALYZE table_name`"
        ],
        [
          "`actual time=X..Y`",
          "X = first row ms, Y = last row ms",
          "High Y = full scan"
        ],
        [
          "`Buffers: hit=N`",
          "Pages served from shared_buffers",
          "More hits = better"
        ],
        [
          "`Buffers: read=N`",
          "Pages read from disk",
          "High = cache miss"
        ]
      ]
    },
