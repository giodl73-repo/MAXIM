    {
      "id": "table-3",
      "line": 500,
      "heading_context": "## EXPLAIN ANALYZE",
      "headers": [
        "Node",
        "Meaning",
        "When to worry"
      ],
      "rows": [
        [
          "`Seq Scan`",
          "Full table scan",
          "Missing index, or table is small (fine)"
        ],
        [
          "`Index Scan`",
          "Index lookup + heap fetch per row",
          "Good for low selectivity"
        ],
        [
          "`Index Only Scan`",
          "All needed cols in index — no heap",
          "Best case"
        ],
        [
          "`Bitmap Heap Scan`",
          "Batches index hits, then heap",
          "Moderate selectivity — normal"
        ],
        [
          "`Hash Join`",
          "Builds hash table on smaller side",
          "Good for large unsorted inputs"
        ],
        [
          "`Merge Join`",
          "Both sides sorted, zipper merge",
          "Good when inputs pre-sorted"
        ],
        [
          "`Nested Loop`",
          "Outer × inner row",
          "Best when inner side is tiny/indexed"
        ]
      ]
    },
    {
