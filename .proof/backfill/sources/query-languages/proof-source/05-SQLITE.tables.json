          "Created by",
          "D. Richard Hipp, 2000 — originally for U.S. Navy destroyers (no server to crash)"
        ],
        [
          "License",
          "Public domain — no copyright, no attribution required, no license to manage"
        ],
        [
          "Current version",
          "SQLite 3.x (continuous point releases, stable ABI)"
        ],
        [
          "Architecture",
          "Serverless, file-based, zero-config, embedded C library"
        ],
        [
          "ACID compliance",
          "Full — WAL mode enables concurrent reads + single writer"
        ],
        [
          "Deployment surface",
          "iOS, Android, macOS, Chrome, Firefox, Python stdlib, .NET, Node.js, R, every browser"
