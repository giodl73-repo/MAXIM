      "headers": [
        "Isolation Level",
        "Dirty Read",
        "Non-Repeatable Read",
        "Phantom Read",
        "Notes"
      ],
      "rows": [
        [
          "READ UNCOMMITTED",
          "possible",
          "possible",
          "possible",
          "Reads uncommitted data; almost never appropriate"
        ],
        [
          "READ COMMITTED",
          "prevented",
          "possible",
          "possible",
          "**Default**: PostgreSQL, SQL Server, Oracle"
        ],
        [
          "REPEATABLE READ",
          "prevented",
          "prevented",
          "possible",
          "**Default**: MySQL InnoDB; re-read rows = same values"
        ],
        [
          "SERIALIZABLE",
          "prevented",
          "prevented",
          "prevented",
          "Appears as if transactions ran serially; highest lock contention"
        ]
      ]
