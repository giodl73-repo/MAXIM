      "headers": [
        "Function",
        "Description"
      ],
      "rows": [
        [
          "`count()`",
          "Row count"
        ],
        [
          "`countif(pred)`",
          "Conditional count"
        ],
        [
          "`sum(col)`",
          "Sum"
        ],
        [
          "`avg(col)`",
          "Average"
        ],
        [
          "`min(col)` / `max()`",
          "Min / max"
        ],
        [
          "`percentile(col, p)`",
          "Single percentile"
        ],
        [
          "`percentiles(col, ...)`",
          "Multiple percentiles in one pass"
        ],
        [
          "`dcount(col)`",
          "Approximate distinct count (fast, HyperLogLog)"
        ],
        [
