      "heading_context": "## 3. DATA TYPES",
      "headers": [
        "KQL Type",
        "SQL Equivalent",
        "Notes"
      ],
      "rows": [
        [
          "`string`",
          "NVARCHAR",
          "UTF-8, always Unicode"
        ],
        [
          "`int`",
          "INT (32-bit)",
          "32-bit signed"
        ],
        [
          "`long`",
          "BIGINT (64-bit)",
          "Default for integer literals"
        ],
        [
          "`real`",
          "FLOAT",
          "64-bit IEEE 754"
        ],
        [
          "`decimal`",
          "DECIMAL",
          "High-precision, slower than real"
        ],
        [
          "`bool`",
          "BIT",
          "`true` / `false` (lowercase)"
        ],
        [
          "`datetime`",
          "DATETIME2 (UTC)",
          "Always UTC, ISO 8601"
        ],
        [
          "`timespan`",
          "No direct equivalent",
          "Duration: `1d`, `2h`, `30m`, `45s`, `100ms`"
        ],
        [
          "`guid`",
          "UNIQUEIDENTIFIER",
          "GUID/UUID"
        ],
        [
          "`dynamic`",
          "JSON / NVARCHAR + JSON path",
          "JSON-like bag — arrays and objects. Very powerful."
        ]
      ]
    },
    {
