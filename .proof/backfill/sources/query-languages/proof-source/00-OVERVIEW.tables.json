      "headers": [
        "Level",
        "Dirty Read",
        "Non-Repeatable Read",
        "Phantom Read",
        "Notes"
      ],
      "rows": [
        [
          "READ UNCOMMITTED",
          "possible",
          "possible",
          "possible",
          "Sees uncommitted data from other txns; almost never use"
        ],
        [
          "READ COMMITTED",
          "prevented",
          "possible",
          "possible",
          "Default in PostgreSQL, SQL Server, Oracle"
        ],
        [
          "REPEATABLE READ",
          "prevented",
          "prevented",
          "possible",
          "Default in MySQL InnoDB; re-read same rows = same values"
        ],
        [
          "SERIALIZABLE",
          "prevented",
          "prevented",
          "prevented",
          "Transactions appear to run serially; highest cost"
        ]
      ]
