      "headers": [
        "Design situation",
        "Ergonomic consideration"
      ],
      "rows": [
        [
          "Designing controls for diverse users",
          "Use 5th %ile reach for all controls"
        ],
        [
          "Designing clearance (doorway, hatch)",
          "Use 95th %ile body breadth/height"
        ],
        [
          "Designing handle/grip",
          "30-40mm diameter power grip; surface texture"
        ],
        [
          "Force-operated mechanism",
          "Maximum 10-15N for consumer products"
        ],
        [
          "Screen readability",
          "Minimum 4:1 contrast; 16px minimum text"
        ],
        [
          "Touch target",
          "Minimum 44x44px (Apple HIG); prefer 48x48"
        ],
        [
          "Color coding",
          "Never color alone; add shape/position"
        ],
        [
          "Preventing errors",
          "Mistake-proofing + confirmation for destructive actions"
        ],
        [
          "Workplace seat height",
          "Adjustable 38-50cm; lumbar support adjustable"
        ]
      ]
