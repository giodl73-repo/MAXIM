      "rows": [
        [
          "Wave speed in vacuum",
          "c = 1/√(μ₀ε₀) = 3×10⁸ m/s"
        ],
        [
          "Wave speed in medium",
          "v = c/n, n = √(εᵣμᵣ)"
        ],
        [
          "E and B relationship",
          "B = k̂×E/c, E⊥B⊥k̂"
        ],
        [
          "Energy flow direction",
          "S = E×B/μ₀ (Poynting)"
        ],
        [
          "Intensity of plane wave",
          "I = cε₀E₀²/2"
        ],
        [
          "Penetration into conductor",
          "δ = √(2/ωμσ) (skin depth)"
        ],
        [
          "Reflection/refraction angles",
          "n₁ sin θ₁ = n₂ sin θ₂ (Snell)"
        ],
        [
          "Total internal reflection",
          "θ > θ_c = arcsin(n₂/n₁)"
        ],
        [
          "Power radiated by accelerating charge",
          "P = q²a²/6πε₀c³"
        ],
        [
          "Does frequency change at interface?",
          "Never — only λ and v change"
        ]
      ]
    }
