      "headers": [
        "Method",
        "How",
        "Use when"
      ],
      "rows": [
        [
          "External standard",
          "build curve from pure standards; read unknown against it",
          "matrix is clean/reproducible"
        ],
        [
          "Internal standard",
          "add fixed amount of a reference compound; use signal ratio",
          "to cancel injection/drift variance (GC/LC-MS)"
        ],
        [
          "**Standard addition**",
          "spike the *sample itself* with known analyte increments; extrapolate",
          "strong, unknown **matrix effects**"
        ]
      ]
