      "headers": [
        "Axis",
        "Python"
      ],
      "rows": [
        [
          "Binding",
          "Late — everything is a runtime attribute lookup via `__dict__`"
        ],
        [
          "Typing",
          "Dynamic"
        ],
        [
          "Strength",
          "Strong — no implicit coercions (`\"1\" + 1` raises TypeError)"
        ],
        [
          "Type system",
          "Duck typing (check at runtime by hasattr)"
        ],
        [
          "Type inference",
          "None at runtime; mypy/pyright for static analysis of hints"
        ],
        [
          "Memory model",
          "Reference counting + cycle-detecting GC; GIL (CPython)"
        ]
      ]
    },
