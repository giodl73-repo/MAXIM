      "heading_context": "## Gotchas from C#",
      "headers": [
        "C# behavior",
        "Swift behavior",
        "Consequence"
      ],
      "rows": [
        [
          "Classes are reference types",
          "Structs (value types) are the default",
          "Copies instead of shared refs"
        ],
        [
          "`null` with `?:` coalesce",
          "`nil` with `??` coalesce",
          "Same concept, different syntax"
        ],
        [
          "`string` length = char count",
          "`string.count` = grapheme count (can differ!)",
          "\"é\" = 1 Character but 2 Unicode scalars"
        ],
        [
          "`using` for IDisposable",
          "`defer` for cleanup",
          "`defer` is statement-based, not scope-based"
        ],
        [
          "`interface` declared separately",
          "Protocol conformance in `extension`",
          "Retroactive conformance is normal"
        ],
        [
          "Generics at runtime",
          "Generics at compile time (monomorphized)",
          "Can't use `T` at runtime for type checks"
        ]
      ]
