        "Meaning",
        "Why it matters"
      ],
      "rows": [
        [
          "Resolution",
          "Bits (e.g. 12) → 2^N codes",
          "Smallest distinguishable step"
        ],
        [
          "Reference (Vref)",
          "Full-scale voltage",
          "Sets the volts-per-code"
        ],
        [
          "Sample rate",
          "Conversions/sec",
          "Must satisfy Nyquist (`signal-processing/`)"
        ],
        [
          "LSB size",
