      "id": "table-5",
      "line": 263,
      "heading_context": "## Bootloaders and OTA — Updating Firmware in the Field",
      "headers": [
        "OTA requirement",
        "Why it's non-negotiable"
      ],
      "rows": [
        [
          "**Atomic swap** (A/B slots)",
          "Power loss mid-write must not leave a half-image"
        ],
        [
          "**Rollback**",
          "A bad update must fall back to the last good image"
        ],
        [
          "**Integrity** (CRC)",
          "Detect a corrupted download before booting it"
        ],
        [
          "**Authenticity** (signature)",
          "Only run images signed by you (secure boot)"
        ],
        [
          "**Versioning / anti-rollback**",
          "Prevent downgrade to a vulnerable old image"
        ],
        [
          "**Watchdog confirmation**",
          "New image must prove it boots/runs before commit"
        ]
      ]
    },
