      "heading_context": "## The HAL — Taming Vendor Registers",
      "headers": [
        "Layer",
        "What it gives you",
        "Cost"
      ],
      "rows": [
        [
          "Bare registers (`02`)",
          "Total control, smallest, fastest",
          "Verbose, vendor-locked, error-prone"
        ],
        [
          "CMSIS",
          "Portable core access, typed register structs",
          "Still register-level"
        ],
        [
          "Vendor HAL",
          "\"Configure peripheral\" API, portability within vendor",
          "Larger, sometimes slow/heavy"
        ],
        [
          "RTOS HAL (Zephyr)",
          "Cross-vendor device API + drivers",
          "Bigger footprint"
        ]
      ]
    },
