    {
      "id": "table-5",
      "line": 186,
      "heading_context": "## Decision Cheat Sheet",
      "headers": [
        "Situation",
        "Do"
      ],
      "rows": [
        [
          "New proc macro or build script",
          "Review as host-executed code and update threat model"
        ],
        [
          "Release build",
          "Use ephemeral least-privilege runner with no production secret"
        ],
        [
          "Toolchain selection",
          "Pin an approved exact version/image and record `rustc -vV`"
        ],
        [
          "Restricted-network claim",
          "Enforce at OS/runtime layer; use `--offline` as supporting evidence"
        ],
        [
          "Signing",
          "Sign the verified digest in a separate authority boundary"
        ],
        [
          "High-consequence artifact",
          "Add independent rebuild or diverse verification where practical"
        ],
        [
          "Build needs native compiler",
          "Pin sysroot/linker/library identities and target matrix"
        ]
      ]
    }
