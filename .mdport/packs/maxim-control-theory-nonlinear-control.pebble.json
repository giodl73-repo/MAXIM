        "id": "maxim:control-theory:nonlinear-control",
        "index_roles": "[guide, root-concept]",
        "kind": "guide",
        "maxim_schema": "maxim.frontmatter.v1",
        "module": "control-theory",
        "remap_from": "[]",
        "remap_to": "[]",
        "root_concepts": "[nonlinear, control]",
        "section": "control-theory",
        "source_custody": "partial",
        "status": "source-custody",
        "title": "Nonlinear Control",
        "updated": "null"
      },
      "text": "LINEARIZATION at x*:\n  A = Jacobian[f](x*) = [∂f₁/∂x₁  ∂f₁/∂x₂]\n                         [∂f₂/∂x₁  ∂f₂/∂x₂]"
    },
    {
      "id": "06-NONLINEAR-CONTROL.md#008",
      "path": [
        "06-NONLINEAR-CONTROL.md"
      ],
      "level": 0,
      "line": 1,
      "metadata": {
