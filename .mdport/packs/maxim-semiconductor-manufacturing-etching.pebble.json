      "text": "```\nETCHING TAXONOMY\n════════════════════════════════════════════════════════════════════"
    },
    {
      "id": "04-ETCHING.md#004",
      "path": [
        "04-ETCHING.md"
      ],
      "level": 0,
      "line": 1,
      "metadata": {
        "backsource_ids": "[mdloom-backfill:semiconductor-manufacturing:04-etching, git-history:semiconductor-manufacturing:04-etching]",
        "canonical_path": "semiconductor-manufacturing/04-ETCHING.md",
