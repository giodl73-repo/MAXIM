      "text": "### Historical Peak and Decline"
    },
    {
      "id": "08-DIGITAL-DISRUPTION.md#007",
      "path": [
        "08-DIGITAL-DISRUPTION.md"
      ],
      "level": 0,
      "line": 1,
      "metadata": {
        "backsource_ids": "[mdloom-backfill:papermaking:08-digital-disruption, git-history:papermaking:08-digital-disruption]",
        "canonical_path": "papermaking/08-DIGITAL-DISRUPTION.md",
        "concepts": "[digital, disruption]",
        "current_path": "papermaking/08-DIGITAL-DISRUPTION.md",
        "id": "maxim:papermaking:digital-disruption",
        "index_roles": "[guide, root-concept]",
        "kind": "guide",
        "maxim_schema": "maxim.frontmatter.v1",
        "module": "papermaking",
