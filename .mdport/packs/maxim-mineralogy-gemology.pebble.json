      "text": "### Cut"
    },
    {
      "id": "07-GEMOLOGY.md#007",
      "path": [
        "07-GEMOLOGY.md"
      ],
      "level": 0,
      "line": 1,
      "metadata": {
        "backsource_ids": "[mdloom-backfill:mineralogy:07-gemology, git-history:mineralogy:07-gemology]",
        "canonical_path": "mineralogy/07-GEMOLOGY.md",
        "concepts": "[gemology]",
        "current_path": "mineralogy/07-GEMOLOGY.md",
        "id": "maxim:mineralogy:gemology",
        "index_roles": "[guide, root-concept]",
        "kind": "guide",
        "maxim_schema": "maxim.frontmatter.v1",
        "module": "mineralogy",
        "remap_from": "[]",
