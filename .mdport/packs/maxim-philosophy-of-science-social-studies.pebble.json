      "text": "### Bloor's Tenets"
    },
    {
      "id": "08-SOCIAL-STUDIES.md#007",
      "path": [
        "08-SOCIAL-STUDIES.md"
      ],
      "level": 0,
      "line": 1,
      "metadata": {
        "backsource_ids": "[mdloom-backfill:philosophy-of-science:08-social-studies, git-history:philosophy-of-science:08-social-studies]",
        "canonical_path": "philosophy-of-science/08-SOCIAL-STUDIES.md",
        "concepts": "[social, studies]",
        "current_path": "philosophy-of-science/08-SOCIAL-STUDIES.md",
        "id": "maxim:philosophy-of-science:social-studies",
        "index_roles": "[guide, root-concept]",
