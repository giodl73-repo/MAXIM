        "id": "maxim:oral-tradition:oral-history",
        "index_roles": "[guide, root-concept]",
        "kind": "guide",
        "maxim_schema": "maxim.frontmatter.v1",
        "module": "oral-tradition",
        "remap_from": "[]",
