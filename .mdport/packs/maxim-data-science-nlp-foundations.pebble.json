      "text": "## 2. Distributional Semantics"
    },
    {
      "id": "16-NLP-FOUNDATIONS.md#027",
      "path": [
        "16-NLP-FOUNDATIONS.md"
      ],
      "level": 0,
      "line": 1,
      "metadata": {
