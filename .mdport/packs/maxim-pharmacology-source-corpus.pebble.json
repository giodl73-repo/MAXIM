        "kind": "guide",
        "maxim_schema": "maxim.frontmatter.v1",
        "module": "pharmacology",
        "remap_from": "[]",
        "remap_to": "[]",
        "root_concepts": "[overview]",
        "section": "pharmacology",
        "source_custody": "partial",
        "status": "source-custody",
        "title": "Pharmacology - Landscape and Taxonomy",
        "updated": "null"
      },
      "text": "AXIS 2: TYPE OF DRUG-TARGET INTERACTION\n  Agonist:      Activates receptor → full or partial response\n  Antagonist:   Blocks receptor → no activation\n  Inverse agonist: Activates constitutively active receptor DOWNWARD\n  Allosteric:   Binds non-active site → modulates activity indirectly"
    },
