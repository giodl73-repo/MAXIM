        "current_path": "music-theory/03-RHYTHM-METER.md",
        "id": "maxim:music-theory:rhythm-meter",
        "index_roles": "[guide, root-concept]",
        "kind": "guide",
        "maxim_schema": "maxim.frontmatter.v1",
        "module": "music-theory",
        "remap_from": "[]",
        "remap_to": "[]",
        "root_concepts": "[rhythm, meter]",
        "section": "music-theory",
        "source_custody": "partial",
        "status": "source-custody",
        "title": "Rhythm and Meter",
        "updated": "null"
      },
      "text": "COMPOUND METER: top number = number of SUBDIVISIONS (not beats!)\n  6/8: 6 eighth notes per bar, but felt as 2 beats of 3 eighths each\n  9/8: 3 beats of 3 eighths\n  12/8: 4 beats of 3 eighths"
    },
    {
      "id": "03-RHYTHM-METER.md#010",
