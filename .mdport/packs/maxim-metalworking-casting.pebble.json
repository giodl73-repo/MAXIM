      "text": "```\nCASTING PROCESS TAXONOMY"
    },
    {
      "id": "02-CASTING.md#004",
      "path": [
        "02-CASTING.md"
      ],
      "level": 0,
      "line": 1,
      "metadata": {
        "backsource_ids": "[proof-backfill:metalworking:02-casting, git-history:metalworking:02-casting]",
        "canonical_path": "metalworking/02-CASTING.md",
