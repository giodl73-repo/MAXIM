      "text": "## Homeostasis: The Control Systems Model"
    },
    {
      "id": "00-OVERVIEW.md#011",
      "path": [
        "00-OVERVIEW.md"
      ],
      "level": 0,
      "line": 1,
      "metadata": {
        "backsource_ids": "[proof-backfill:human-biology:00-overview, git-history:human-biology:00-overview]",
