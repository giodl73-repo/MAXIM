      "text": "## Engineering Analogies: Body Systems as Distributed Architecture"
    },
    {
      "id": "00-OVERVIEW.md#027",
      "path": [
        "00-OVERVIEW.md"
      ],
      "level": 0,
      "line": 1,
      "metadata": {
        "backsource_ids": "[proof-backfill:human-biology:00-overview, git-history:human-biology:00-overview]",
        "canonical_path": "human-biology/00-OVERVIEW.md",
        "concepts": "[overview]",
