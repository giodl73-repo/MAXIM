      "text": "## Primary Orality vs. Oral-Derived Texts"
    },
    {
      "id": "00-OVERVIEW.md#032",
      "path": [
        "00-OVERVIEW.md"
      ],
      "level": 0,
      "line": 1,
      "metadata": {
