        "current_path": "metalworking/05-MACHINING.md",
        "id": "maxim:metalworking:machining",
        "index_roles": "[guide, root-concept]",
        "kind": "guide",
        "maxim_schema": "maxim.frontmatter.v1",
        "module": "metalworking",
        "remap_from": "[]",
        "remap_to": "[]",
        "root_concepts": "[machining]",
        "section": "metalworking",
        "source_custody": "partial",
        "status": "source-custody",
        "title": "Machining",
        "updated": "null"
      },
      "text": "CHIP FORMATION TYPES:\n  Continuous chip: ductile materials (Al, mild steel); smooth cutting\n  Segmental chip: many engineering materials; periodic fracture\n  Discontinuous chip: brittle materials (cast iron, hard plastics); broken chunks\n  Built-up edge (BUE): work material welds to tool at low speeds\n                        → changes effective rake; creates rough surface; must avoid\n                        → increase speed to avoid BUE temperature regime\n```"
    },
