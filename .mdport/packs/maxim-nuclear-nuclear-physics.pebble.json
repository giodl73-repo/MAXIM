        "concepts": "[nuclear, physics]",
        "current_path": "nuclear/01-NUCLEAR-PHYSICS.md",
        "id": "maxim:nuclear:nuclear-physics",
        "index_roles": "[guide, root-concept]",
        "kind": "guide",
