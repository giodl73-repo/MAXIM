      "text": "XNU = \"X is Not Unix\". Hybrid kernel combining Mach microkernel, BSD layer, and IOKit."
    },
    {
      "id": "04-MACOS.md#006",
      "path": [
        "04-MACOS.md"
      ],
      "level": 0,
      "line": 1,
      "metadata": {
        "backsource_ids": "[mdloom-backfill:os:04-macos, git-history:os:04-macos]",
        "canonical_path": "os/04-MACOS.md",
        "concepts": "[macos]",
        "current_path": "os/04-MACOS.md",
        "id": "maxim:os:macos",
        "index_roles": "[guide, root-concept]",
        "kind": "guide",
        "maxim_schema": "maxim.frontmatter.v1",
        "module": "os",
        "remap_from": "[]",
