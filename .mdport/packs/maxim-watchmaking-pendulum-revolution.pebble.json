      },
      "text": "## Christiaan Huygens (1656)"
    },
    {
      "id": "03-PENDULUM-REVOLUTION.md#029",
      "path": [
        "03-PENDULUM-REVOLUTION.md"
      ],
      "level": 0,
      "line": 1,
      "metadata": {
