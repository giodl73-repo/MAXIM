      "text": "## Signal Processing Bridge — Manual Filters → Learned Filters"
    },
    {
      "id": "15-COMPUTER-VISION.md#005",
      "path": [
        "15-COMPUTER-VISION.md"
      ],
      "level": 0,
      "line": 1,
      "metadata": {
        "backsource_ids": "[mdloom-backfill:data-science:15-computer-vision, git-history:data-science:15-computer-vision]",
        "canonical_path": "data-science/15-COMPUTER-VISION.md",
        "concepts": "[computer, vision]",
        "current_path": "data-science/15-COMPUTER-VISION.md",
        "id": "maxim:data-science:computer-vision",
        "index_roles": "[guide, root-concept]",
        "kind": "guide",
