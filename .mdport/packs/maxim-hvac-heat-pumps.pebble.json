      "text": "## The Big Picture"
    },
    {
      "id": "05-HEAT-PUMPS.md#002",
      "path": [
        "05-HEAT-PUMPS.md"
      ],
      "level": 0,
      "line": 1,
      "metadata": {
        "backsource_ids": "[proof-backfill:hvac:05-heat-pumps, git-history:hvac:05-heat-pumps]",
