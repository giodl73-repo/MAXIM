        "root_concepts": "[epic, and]",
        "section": "literature",
        "source_custody": "partial",
        "status": "source-custody",
        "title": "Epic and Lyric",
        "updated": "null"
      },
      "text": "Previous scholarship: Homer used these for emphasis or style."
    },
    {
      "id": "02-EPIC-AND-LYRIC.md#009",
      "path": [
        "02-EPIC-AND-LYRIC.md"
      ],
      "level": 0,
      "line": 1,
      "metadata": {
