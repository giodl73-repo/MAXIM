        "concepts": "[epic, and, lyric]",
        "current_path": "literature/02-EPIC-AND-LYRIC.md",
        "id": "maxim:literature:epic-and-lyric",
        "index_roles": "[guide, root-concept]",
        "kind": "guide",
        "maxim_schema": "maxim.frontmatter.v1",
        "module": "literature",
        "remap_from": "[]",
        "remap_to": "[]",
        "root_concepts": "[epic, and]",
        "section": "literature",
        "source_custody": "partial",
        "status": "source-custody",
        "title": "Epic and Lyric",
        "updated": "null"
      },
      "text": "A FORMULA = a group of words regularly used under the same\n            metrical conditions to express a given essential idea."
    },
    {
      "id": "02-EPIC-AND-LYRIC.md#011",
      "path": [
        "02-EPIC-AND-LYRIC.md"
      ],
      "level": 0,
      "line": 1,
