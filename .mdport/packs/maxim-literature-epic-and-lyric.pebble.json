        "root_concepts": "[epic, and]",
        "section": "literature",
        "source_custody": "partial",
        "status": "source-custody",
        "title": "Epic and Lyric",
        "updated": "null"
      },
      "text": "Each performance is a new GENERATION of the poem from this grammar.\n  Not variation from a fixed original. Generation from a system."
    },
