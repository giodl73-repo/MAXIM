    {
      "id": "05-ECOLOGY.md#012",
      "path": [
        "05-ECOLOGY.md"
      ],
      "level": 0,
      "line": 1,
      "metadata": {
        "backsource_ids": "[mdloom-backfill:biology:05-ecology, git-history:biology:05-ecology]",
        "canonical_path": "biology/05-ECOLOGY.md",
        "concepts": "[ecology]",
