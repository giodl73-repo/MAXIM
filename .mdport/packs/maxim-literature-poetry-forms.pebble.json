        "root_concepts": "[poetry, forms]",
        "section": "literature",
        "source_custody": "partial",
        "status": "source-custody",
        "title": "Poetry Forms and Prosody",
        "updated": "null"
      },
      "text": "Stanza 1: lines end A B C D E F\nStanza 2: lines end F A E B D C\nStanza 3: lines end C F D A B E\nStanza 4: lines end E C B F A D\nStanza 5: lines end D E A C F B\nStanza 6: lines end B D F E C A\nEnvoi (3 lines): each line contains 2 of the 6 words"
    },
    {
      "id": "05-POETRY-FORMS.md#030",
      "path": [
        "05-POETRY-FORMS.md"
      ],
      "level": 0,
      "line": 1,
      "metadata": {
