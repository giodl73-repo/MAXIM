        "root_concepts": "[fertility]",
        "section": "demography",
        "source_custody": "partial",
        "status": "source-custody",
        "title": "Fertility",
        "updated": "null"
      },
      "text": "INTERPRETATION:\n  Average number of children a woman would have if she experienced\n  the current age-specific fertility rates throughout her reproductive life.\n  This is a SYNTHETIC COHORT measure — no real woman experiences this."
    },
    {
