        "current_path": "abstract-algebra/05-POLYNOMIALS-FIELDS.md",
        "id": "maxim:abstract-algebra:polynomials-fields",
        "index_roles": "[guide, root-concept]",
        "kind": "guide",
        "maxim_schema": "maxim.frontmatter.v1",
        "module": "abstract-algebra",
        "remap_from": "[]",
