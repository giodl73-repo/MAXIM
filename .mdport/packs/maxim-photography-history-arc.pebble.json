      "text": "```\nPHOTOGRAPHY HISTORY — TIMELINE:"
    },
    {
      "id": "09-HISTORY-ARC.md#004",
      "path": [
        "09-HISTORY-ARC.md"
      ],
      "level": 0,
      "line": 1,
      "metadata": {
        "backsource_ids": "[mdloom-backfill:photography:09-history-arc, git-history:photography:09-history-arc]",
        "canonical_path": "photography/09-HISTORY-ARC.md",
