      },
      "text": "```\nDEMOGRAPHIC TRANSITIONS — TWO WAVES:"
    },
    {
      "id": "06-FAMILY-DEMOGRAPHIC-CHANGE.md#004",
      "path": [
        "06-FAMILY-DEMOGRAPHIC-CHANGE.md"
      ],
      "level": 0,
      "line": 1,
      "metadata": {
        "backsource_ids": "[mdloom-backfill:sociology:06-family-demographic-change, git-history:sociology:06-family-demographic-change]",
        "canonical_path": "sociology/06-FAMILY-DEMOGRAPHIC-CHANGE.md",
        "concepts": "[family, demographic, change]",
        "current_path": "sociology/06-FAMILY-DEMOGRAPHIC-CHANGE.md",
        "id": "maxim:sociology:family-demographic-change",
        "index_roles": "[guide, root-concept]",
        "kind": "guide",
        "maxim_schema": "maxim.frontmatter.v1",
        "module": "sociology",
        "remap_from": "[]",
