      "text": "## The Pragmatics Problem"
    },
    {
      "id": "08-PRAGMATICS.md#002",
      "path": [
        "08-PRAGMATICS.md"
      ],
      "level": 0,
      "line": 1,
      "metadata": {
        "backsource_ids": "[mdloom-backfill:philosophy-of-language:08-pragmatics, git-history:philosophy-of-language:08-pragmatics]",
