        "current_path": "plastics-polymers/07-ENVIRONMENTAL.md",
        "id": "maxim:plastics-polymers:environmental",
        "index_roles": "[guide, root-concept]",
        "kind": "guide",
        "maxim_schema": "maxim.frontmatter.v1",
        "module": "plastics-polymers",
        "remap_from": "[]",
        "remap_to": "[]",
        "root_concepts": "[environmental]",
        "section": "plastics-polymers",
        "source_custody": "partial",
        "status": "source-custody",
        "title": "Environmental Impact and Microplastics",
        "updated": "null"
      },
      "text": "HYDROLYSIS\n   ──────────\n   Water cleaves ester/amide bonds\n   PET, nylons, PU, PLA susceptible (hydrolyzable backbone)\n   Rate: pH, temperature dependent\n   PET bottle in ocean: ~450 years to full degradation (estimated)"
    },
    {
      "id": "07-ENVIRONMENTAL.md#008",
      "path": [
        "07-ENVIRONMENTAL.md"
      ],
      "level": 0,
