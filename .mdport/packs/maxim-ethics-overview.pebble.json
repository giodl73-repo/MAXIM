      "text": "```\nHUME'S GUILLOTINE (1739)\n=========================="
    },
    {
      "id": "00-OVERVIEW.md#006",
      "path": [
        "00-OVERVIEW.md"
      ],
      "level": 0,
      "line": 1,
      "metadata": {
        "backsource_ids": "[mdloom-backfill:ethics:00-overview, git-history:ethics:00-overview]",
