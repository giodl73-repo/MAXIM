        "current_path": "photography/08-COMPUTATIONAL-PHOTOGRAPHY.md",
        "id": "maxim:photography:computational-photography",
        "index_roles": "[guide, root-concept]",
        "kind": "guide",
        "maxim_schema": "maxim.frontmatter.v1",
        "module": "photography",
        "remap_from": "[]",
        "remap_to": "[]",
        "root_concepts": "[computational, photography]",
        "section": "photography",
        "source_custody": "partial",
        "status": "source-custody",
        "title": "Computational Photography",
        "updated": "null"
      },
      "text": "Applications:\n    Macro photography: DoF measured in millimeters → must stack many frames\n    Landscape: infinity to foreground in focus simultaneously\n    Product photography: technical detail across 3D objects\n    Microscopy: standard technique (depth sectioning)\n    Focus-bracketing cameras: Olympus/OM System, Sony, Nikon → automated in-camera"
    },
    {
      "id": "08-COMPUTATIONAL-PHOTOGRAPHY.md#030",
      "path": [
        "08-COMPUTATIONAL-PHOTOGRAPHY.md"
      ],
      "level": 0,
      "line": 1,
      "metadata": {
        "backsource_ids": "[proof-backfill:photography:08-computational-photography, git-history:photography:08-computational-photography]",
