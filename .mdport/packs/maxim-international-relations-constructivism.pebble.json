        "root_concepts": "[constructivism]",
        "section": "international-relations",
        "source_custody": "partial",
        "status": "source-custody",
        "title": "Constructivism: Wendt's Social Theory of IR",
        "updated": "null"
      },
      "text": "CONSTRUCTIVISM SAYS:\n  ┌─────────────────────────────────────────────────────────┐\n  │  • Identities and interests are CONSTRUCTED through     │\n  │    social interaction, not given by nature or structure │\n  │  • Anarchy is what STATES MAKE OF IT                    │\n  │  • Ideas, norms, and culture matter materially          │\n  │  • The same material distribution of power means        │\n  │    different things to differently constituted actors   │\n  └─────────────────────────────────────────────────────────┘"
    },
