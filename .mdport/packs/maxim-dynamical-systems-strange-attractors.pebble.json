      "text": "## The Lorenz System"
    },
    {
      "id": "06-STRANGE-ATTRACTORS.md#013",
      "path": [
        "06-STRANGE-ATTRACTORS.md"
      ],
      "level": 0,
      "line": 1,
      "metadata": {
