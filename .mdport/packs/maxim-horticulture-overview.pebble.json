        "module": "horticulture",
        "remap_from": "[]",
        "remap_to": "[]",
        "root_concepts": "[overview]",
        "section": "horticulture",
        "source_custody": "partial",
        "status": "source-custody",
        "title": "Horticulture - Landscape and Taxonomy",
        "updated": "null"
      },
      "text": "AGRICULTURE\n  +----------------------------------+\n  | Field crops: grain, oilseed, hay |\n  | Large-scale, extensive           |\n  | Commodity production             |\n  | Mechanized, low labor/acre       |\n  | Few species per farm             |\n  | Long shelf life (grain)          |\n  | Price-taker (commodity market)   |\n  +----------------------------------+"
    },
    {
      "id": "00-OVERVIEW.md#005",
      "path": [
        "00-OVERVIEW.md"
      ],
      "level": 0,
      "line": 1,
      "metadata": {
        "backsource_ids": "[mdloom-backfill:horticulture:00-overview, git-history:horticulture:00-overview]",
        "canonical_path": "horticulture/00-OVERVIEW.md",
