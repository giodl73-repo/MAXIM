      "text": "```\nHORTICULTURE vs AGRICULTURE DISTINCTION:"
    },
    {
      "id": "00-OVERVIEW.md#004",
      "path": [
        "00-OVERVIEW.md"
      ],
      "level": 0,
      "line": 1,
      "metadata": {
        "backsource_ids": "[mdloom-backfill:horticulture:00-overview, git-history:horticulture:00-overview]",
