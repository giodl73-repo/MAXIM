      "text": "```\n  METAGENOMICS: SEQUENCING MICROBIAL COMMUNITIES\n  ================================================"
    },
    {
      "id": "00-OVERVIEW.md#016",
      "path": [
        "00-OVERVIEW.md"
      ],
      "level": 0,
      "line": 1,
      "metadata": {
        "backsource_ids": "[proof-backfill:microbiology:00-overview, git-history:microbiology:00-overview]",
