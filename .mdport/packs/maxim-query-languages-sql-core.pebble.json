        "current_path": "query-languages/01-SQL-CORE.md",
        "id": "maxim:query-languages:sql-core",
        "index_roles": "[guide, root-concept]",
        "kind": "guide",
        "maxim_schema": "maxim.frontmatter.v1",
        "module": "query-languages",
        "remap_from": "[]",
