        "id": "maxim:translation:interpretation",
        "index_roles": "[guide, root-concept]",
        "kind": "guide",
        "maxim_schema": "maxim.frontmatter.v1",
        "module": "translation",
        "remap_from": "[]",
        "remap_to": "[]",
        "root_concepts": "[interpretation]",
        "section": "translation",
        "source_custody": "partial",
        "status": "source-custody",
        "title": "Simultaneous and Consecutive Interpretation",
        "updated": "null"
      },
      "text": "TRIGGERS FOR OVERLOAD:\n  ┌─────────────────────────────────────────────────────┐\n  │ • Speaker talks too fast                            │\n  │ • Unfamiliar topic or terminology                   │\n  │ • Dense information (numbers, proper names)         │\n  │ • Long sentences requiring held memory              │\n  │ • Accent or voice quality requiring extra L effort  │\n  │ • Background noise increasing L effort              │\n  └─────────────────────────────────────────────────────┘"
    },
    {
      "id": "07-INTERPRETATION.md#023",
      "path": [
        "07-INTERPRETATION.md"
      ],
      "level": 0,
      "line": 1,
      "metadata": {
        "backsource_ids": "[mdloom-backfill:translation:07-interpretation, git-history:translation:07-interpretation]",
