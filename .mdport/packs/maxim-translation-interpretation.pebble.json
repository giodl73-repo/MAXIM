        "concepts": "[interpretation]",
        "current_path": "translation/07-INTERPRETATION.md",
        "id": "maxim:translation:interpretation",
        "index_roles": "[guide, root-concept]",
        "kind": "guide",
        "maxim_schema": "maxim.frontmatter.v1",
        "module": "translation",
        "remap_from": "[]",
        "remap_to": "[]",
        "root_concepts": "[interpretation]",
        "section": "translation",
        "source_custody": "partial",
        "status": "source-custody",
        "title": "Simultaneous and Consecutive Interpretation",
        "updated": "null"
      },
      "text": "COPING STRATEGIES:\n  • Simplification (produce simpler target text)\n  • Omission (drop parts of the message)\n  • Approximation (use near-synonyms)\n  • Delay (increase lag to complete processing)\n  • Switch to consecutive (if possible — conference rules)"
    },
    {
      "id": "07-INTERPRETATION.md#024",
      "path": [
        "07-INTERPRETATION.md"
      ],
      "level": 0,
      "line": 1,
      "metadata": {
        "backsource_ids": "[mdloom-backfill:translation:07-interpretation, git-history:translation:07-interpretation]",
        "canonical_path": "translation/07-INTERPRETATION.md",
        "concepts": "[interpretation]",
        "current_path": "translation/07-INTERPRETATION.md",
        "id": "maxim:translation:interpretation",
        "index_roles": "[guide, root-concept]",
        "kind": "guide",
        "maxim_schema": "maxim.frontmatter.v1",
        "module": "translation",
