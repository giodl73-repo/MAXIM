        "title": "Graph Traversal",
        "updated": "null"
      },
      "text": "The **white/gray/black** coloring is the key:"
    },
    {
      "id": "02-TRAVERSAL.md#023",
      "path": [
        "02-TRAVERSAL.md"
      ],
      "level": 0,
      "line": 1,
      "metadata": {
