      "text": "### Definition and Units"
    },
    {
      "id": "02-VO2MAX.md#009",
      "path": [
        "02-VO2MAX.md"
      ],
      "level": 0,
      "line": 1,
      "metadata": {
        "backsource_ids": "[mdloom-backfill:sports-science:02-vo2max, git-history:sports-science:02-vo2max]",
