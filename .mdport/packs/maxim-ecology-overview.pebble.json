      "text": "## Abiotic vs Biotic Factors"
    },
    {
      "id": "00-OVERVIEW.md#006",
      "path": [
        "00-OVERVIEW.md"
      ],
      "level": 0,
      "line": 1,
      "metadata": {
        "backsource_ids": "[mdloom-backfill:ecology:00-overview, git-history:ecology:00-overview]",
