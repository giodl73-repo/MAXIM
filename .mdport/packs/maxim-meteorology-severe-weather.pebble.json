        "section": "meteorology",
        "source_custody": "partial",
        "status": "source-custody",
        "title": "Severe Weather - Supercells, Tornadoes, Tropical Cyclones",
        "updated": "null"
      },
      "text": "A derecho is a long-lived, widespread, straight-line wind damage event associated with a squall line:"
    },
    {
      "id": "06-SEVERE-WEATHER.md#035",
      "path": [
        "06-SEVERE-WEATHER.md"
      ],
      "level": 0,
      "line": 1,
      "metadata": {
        "backsource_ids": "[mdloom-backfill:meteorology:06-severe-weather, git-history:meteorology:06-severe-weather]",
        "canonical_path": "meteorology/06-SEVERE-WEATHER.md",
        "concepts": "[severe, weather]",
        "current_path": "meteorology/06-SEVERE-WEATHER.md",
        "id": "maxim:meteorology:severe-weather",
        "index_roles": "[guide, root-concept]",
        "kind": "guide",
        "maxim_schema": "maxim.frontmatter.v1",
        "module": "meteorology",
        "remap_from": "[]",
