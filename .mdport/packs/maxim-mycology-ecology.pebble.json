      "text": "CARBON AND NUTRIENT FLOW THROUGH THE FUNGAL WEB:"
    },
    {
      "id": "03-ECOLOGY.md#004",
      "path": [
        "03-ECOLOGY.md"
      ],
      "level": 0,
      "line": 1,
      "metadata": {
        "backsource_ids": "[mdloom-backfill:mycology:03-ecology, git-history:mycology:03-ecology]",
