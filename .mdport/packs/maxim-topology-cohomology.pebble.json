        "source_custody": "partial",
        "status": "source-custody",
        "title": "Cohomology",
        "updated": "null"
      },
      "text": "COCYCLES: Zⁿ = ker(δⁿ) = {cochains f with δf = 0}\nCOBOUNDARIES: Bⁿ = im(δⁿ⁻¹) = {cochains of the form f = δg}"
    },
    {
      "id": "08-COHOMOLOGY.md#011",
      "path": [
        "08-COHOMOLOGY.md"
      ],
      "level": 0,
      "line": 1,
      "metadata": {
        "backsource_ids": "[mdloom-backfill:topology:08-cohomology, git-history:topology:08-cohomology]",
