        "maxim_schema": "maxim.frontmatter.v1",
        "module": "coatings",
        "remap_from": "[]",
        "remap_to": "[]",
        "root_concepts": "[paint, composition]",
        "section": "coatings",
        "source_custody": "partial",
        "status": "source-custody",
        "title": "Paint Composition",
        "updated": "null"
      },
      "text": "┌──────────────────────────────────────────────────────────────────┐\n│  Component    │ Function              │ % by weight (typical)    │\n├──────────────────────────────────────────────────────────────────┤\n│  Binder       │ Forms the film;       │ 20–40%                   │\n│  (vehicle)    │ holds pigment         │                          │\n├──────────────────────────────────────────────────────────────────┤\n│  Pigment      │ Color, opacity,       │ 10–30% (pigment only)    │\n│               │ sometimes rust inhib. │ + extenders add ~20%     │\n├──────────────────────────────────────────────────────────────────┤\n│  Solvent/     │ Enables application;  │ 30–60% (water-based)     │\n│  Carrier      │ evaporates; sets VOC  │ 25–50% (oil-based)       │\n├──────────────────────────────────────────────────────────────────┤\n│  Additives    │ Performance tuning:   │ <5% total, but essential │\n│               │ thickening, biocides, │                          │\n│               │ driers, coalescing    │                          │\n└──────────────────────────────────────────────────────────────────┘"
    },
