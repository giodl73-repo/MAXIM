    {
      "id": "01-ENTROPY-INFORMATION.md#003",
      "path": [
        "01-ENTROPY-INFORMATION.md"
      ],
      "level": 0,
      "line": 1,
      "metadata": {
        "backsource_ids": "[mdloom-backfill:information-theory:01-entropy-information, git-history:information-theory:01-entropy-information]",
        "canonical_path": "information-theory/01-ENTROPY-INFORMATION.md",
        "concepts": "[entropy, information]",
        "current_path": "information-theory/01-ENTROPY-INFORMATION.md",
        "id": "maxim:information-theory:entropy-information",
        "index_roles": "[guide, root-concept]",
        "kind": "guide",
        "maxim_schema": "maxim.frontmatter.v1",
        "module": "information-theory",
        "remap_from": "[]",
