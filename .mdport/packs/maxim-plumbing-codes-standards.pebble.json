      "text": "## Supply Pipe Sizing"
    },
    {
      "id": "09-CODES-STANDARDS.md#021",
      "path": [
        "09-CODES-STANDARDS.md"
      ],
      "level": 0,
      "line": 1,
      "metadata": {
        "backsource_ids": "[mdloom-backfill:plumbing:09-codes-standards, git-history:plumbing:09-codes-standards]",
        "canonical_path": "plumbing/09-CODES-STANDARDS.md",
