        "updated": "null"
      },
      "text": "```\nRESILIENCE vs. RELIABILITY vs. ROBUSTNESS\n=========================================="
    },
    {
      "id": "03-RESILIENCE.md#004",
      "path": [
        "03-RESILIENCE.md"
      ],
      "level": 0,
      "line": 1,
      "metadata": {
        "backsource_ids": "[proof-backfill:infrastructure-systems:03-resilience, git-history:infrastructure-systems:03-resilience]",
