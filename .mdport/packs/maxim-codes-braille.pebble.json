      "text": "## Grade 1: The Full Alphabet"
    },
    {
      "id": "02-BRAILLE.md#011",
      "path": [
        "02-BRAILLE.md"
      ],
      "level": 0,
      "line": 1,
      "metadata": {
        "backsource_ids": "[mdloom-backfill:codes:02-braille, git-history:codes:02-braille]",
        "canonical_path": "codes/02-BRAILLE.md",
        "concepts": "[braille]",
        "current_path": "codes/02-BRAILLE.md",
        "id": "maxim:codes:braille",
        "index_roles": "[guide, root-concept]",
        "kind": "guide",
