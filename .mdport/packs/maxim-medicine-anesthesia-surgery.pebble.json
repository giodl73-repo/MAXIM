        "current_path": "medicine/09-ANESTHESIA-SURGERY.md",
        "id": "maxim:medicine:anesthesia-surgery",
        "index_roles": "[guide, root-concept]",
        "kind": "guide",
        "maxim_schema": "maxim.frontmatter.v1",
        "module": "medicine",
        "remap_from": "[]",
