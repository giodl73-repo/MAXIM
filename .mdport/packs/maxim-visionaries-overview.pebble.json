      "text": "## What a Visionary Is"
    },
    {
      "id": "00-OVERVIEW.md#002",
      "path": [
        "00-OVERVIEW.md"
      ],
      "level": 0,
      "line": 1,
      "metadata": {
        "backsource_ids": "[proof-backfill:visionaries:00-overview, git-history:visionaries:00-overview]",
