        "root_concepts": "[physiology]",
        "section": "biology",
        "source_custody": "partial",
        "status": "source-custody",
        "title": "06 - Physiology",
        "updated": "null"
      },
      "text": "ORGAN SYSTEMS AND THEIR FUNCTIONS:\n  ┌──────────────────────────────────────────────────────────────┐\n  │ Nervous:       rapid signal integration; sensory + motor     │\n  │ Endocrine:     slow chemical signals; long-range coordination│\n  │ Cardiovascular:pump + distribute O₂, nutrients, hormones     │\n  │ Respiratory:   O₂/CO₂ exchange; acid-base balance            │\n  │ Digestive:     absorb nutrients; eliminate waste             │\n  │ Renal (kidney):filter blood; regulate fluid/electrolyte/pH   │\n  │ Immune:        defense against pathogens; self/non-self      │\n  │ Musculoskeletal:movement, posture, calcium reservoir         │\n  │ Reproductive:  gamete production; development                │\n  └──────────────────────────────────────────────────────────────┘"
    },
    {
      "id": "06-PHYSIOLOGY.md#008",
      "path": [
        "06-PHYSIOLOGY.md"
      ],
      "level": 0,
      "line": 1,
      "metadata": {
        "backsource_ids": "[mdloom-backfill:biology:06-physiology, git-history:biology:06-physiology]",
        "canonical_path": "biology/06-PHYSIOLOGY.md",
        "concepts": "[physiology]",
        "current_path": "biology/06-PHYSIOLOGY.md",
        "id": "maxim:biology:physiology",
        "index_roles": "[guide, root-concept]",
        "kind": "guide",
        "maxim_schema": "maxim.frontmatter.v1",
        "module": "biology",
        "remap_from": "[]",
