        "source_custody": "partial",
        "status": "source-custody",
        "title": "Quadratic Reciprocity",
        "updated": "null"
      },
      "text": "(p/q) · (q/p) = (-1)^{(p-1)/2 · (q-1)/2}"
    },
    {
      "id": "04-QUADRATIC-RECIPROCITY.md#028",
      "path": [
        "04-QUADRATIC-RECIPROCITY.md"
      ],
      "level": 0,
      "line": 1,
      "metadata": {
        "backsource_ids": "[mdloom-backfill:number-theory:04-quadratic-reciprocity, git-history:number-theory:04-quadratic-reciprocity]",
        "canonical_path": "number-theory/04-QUADRATIC-RECIPROCITY.md",
        "concepts": "[quadratic, reciprocity]",
        "current_path": "number-theory/04-QUADRATIC-RECIPROCITY.md",
        "id": "maxim:number-theory:quadratic-reciprocity",
        "index_roles": "[guide, root-concept]",
        "kind": "guide",
        "maxim_schema": "maxim.frontmatter.v1",
        "module": "number-theory",
        "remap_from": "[]",
