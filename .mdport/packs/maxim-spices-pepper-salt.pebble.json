        "id": "maxim:spices:pepper-salt",
        "index_roles": "[guide, root-concept]",
        "kind": "guide",
        "maxim_schema": "maxim.frontmatter.v1",
        "module": "spices",
        "remap_from": "[]",
        "remap_to": "[]",
        "root_concepts": "[pepper, salt]",
        "section": "spices",
        "source_custody": "partial",
        "status": "source-custody",
        "title": "Pepper and Salt - The Two Universal Spices",
        "updated": "null"
      },
      "text": "Venice's mechanism:\n  +-------------------------------------------+\n  | Venice controlled Levantine port access   |\n  | (Alexandria, Beirut, Acre)                |\n  | Any European buyer had to go through      |\n  | Venice. No alternatives. No bypass.       |\n  | This is rent extraction via geographic    |\n  | chokepoint - a classic platform monopoly. |\n  +-------------------------------------------+"
    },
    {
      "id": "01-PEPPER-SALT.md#022",
      "path": [
        "01-PEPPER-SALT.md"
      ],
      "level": 0,
      "line": 1,
      "metadata": {
        "backsource_ids": "[proof-backfill:spices:01-pepper-salt, git-history:spices:01-pepper-salt]",
