      "headers": [
        "Rule",
        "Formula",
        "Notes"
      ],
      "rows": [
        [
          "Fixed",
          "α_k = α",
          "Need α ≤ 1/L; simple"
        ],
        [
          "Backtracking (Armijo)",
          "Reduce α until f(x−α∇f) ≤ f(x) − c·α‖∇f‖²",
          "No L required"
        ],
        [
          "Wolfe conditions",
          "Armijo + curvature",
          "Standard for quasi-Newton"
        ],
        [
          "Exact line search",
          "α = argmin_α f(x_k − α∇f)",
          "Optimal; expensive"
        ],
        [
          "Polyak",
          "α_k = (f(x_k) − f*)/‖∇f‖²",
          "Optimal; requires knowing f*"
        ]
      ]
    },
