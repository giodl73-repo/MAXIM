      "heading_context": "## 1. The Four Principles",
      "headers": [
        "Principle",
        "Core idea",
        "Bedside expression"
      ],
      "rows": [
        [
          "**Autonomy**",
          "respect the person's right to self-determination",
          "informed consent; the right to refuse"
        ],
        [
          "**Beneficence**",
          "act in the patient's benefit",
          "recommend what helps; promote wellbeing"
        ],
        [
          "**Non-maleficence**",
          "avoid causing harm (*primum non nocere*)",
          "weigh harms; avoid net-harmful interventions"
        ],
        [
          "**Justice**",
          "fair distribution of benefits, risks, costs",
          "equitable access; allocation of scarce resources"
        ]
      ]
    },
    {
      "id": "table-2",
