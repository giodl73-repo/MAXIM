      "headers": [
        "Instrument",
        "What it is",
        "Role"
      ],
      "rows": [
        [
          "**Living will**",
          "a written statement of treatment wishes for future incapacity",
          "expresses substantive preferences"
        ],
        [
          "**Durable power of attorney / healthcare proxy**",
          "names a person to decide if capacity is lost",
          "designates the decision-maker"
        ]
      ]
    },
