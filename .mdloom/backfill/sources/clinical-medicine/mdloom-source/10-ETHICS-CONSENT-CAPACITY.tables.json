      "headers": [
        "Dimension",
        "The dominant (Western) frame",
        "Common variation"
      ],
      "rows": [
        [
          "Locus of decision",
          "the individual patient",
          "family- or community-mediated decisions"
        ],
        [
          "Disclosure norm",
          "full, direct disclosure to the patient",
          "in some cultures, information mediated through family; non-disclosure preferences"
        ],
        [
          "Weighting of principles",
          "autonomy often first among equals",
          "beneficence/non-maleficence or community weighted more heavily"
        ],
        [
          "Definition of \"best\"",
          "individual self-determination",
          "relational, familial, or communal wellbeing"
        ]
