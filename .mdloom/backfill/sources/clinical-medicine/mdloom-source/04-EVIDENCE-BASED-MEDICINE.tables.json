      "headers": [
        "Threat to external validity",
        "Question it forces"
      ],
      "rows": [
        [
          "**Population indirectness**",
          "is this patient like the trial's patients (age, comorbidity, ancestry, sex)?"
        ],
        [
          "**Efficacy vs effectiveness**",
          "trial conditions (ideal adherence, monitoring) vs real-world use"
        ],
        [
          "**Comparator indirectness**",
          "was the trial's comparator the alternative this patient actually faces?"
        ],
        [
          "**Setting/resource indirectness**",
          "does the trial's health system resemble this one (guide 08)?"
        ],
        [
          "**Effect modification**",
          "is there a subgroup for whom the effect differs (real, pre-specified — not fishing)?"
        ]
      ]
