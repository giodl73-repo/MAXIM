          "Reuse already-computed expressions",
          "Available expressions (forward, intersection) → CSE"
        ],
        [
          "Compute dominance",
          "Forward intersection dataflow, or Lengauer-Tarjan for the tree"
        ],
        [
          "Iterate efficiently",
          "Worklist + reverse-postorder (forward) / postorder (backward)"
        ],
