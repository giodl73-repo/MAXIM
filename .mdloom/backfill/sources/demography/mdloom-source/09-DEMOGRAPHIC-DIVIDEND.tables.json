      "heading_context": "## Decision Cheat Sheet",
      "headers": [
        "Dividend question",
        "Key point"
      ],
      "rows": [
        [
          "When does the dividend start?",
          "When total dependency ratio falls below historical average"
        ],
        [
          "How large is the effect?",
          "0.5-2% additional GDP growth per year; ~1/3 of East Asian miracle"
        ],
        [
          "Is it automatic?",
          "No — requires fertility decline + job creation + education + institutions"
        ],
        [
          "Can Africa capture its dividend?",
          "Yes, with right investment; no, without — currently a policy race"
        ],
        [
          "What ends the dividend?",
          "Working-age bulge ages into retirement → OADR rises → dividend closes"
        ],
        [
          "What is the second dividend?",
          "Capital stock accumulated by working cohort persists; requires funded pension systems"
        ],
        [
          "Can a country \"miss\" its dividend?",
          "Yes — Nigeria, Egypt have large working-age populations but poor job creation"
        ]
      ]
    }
