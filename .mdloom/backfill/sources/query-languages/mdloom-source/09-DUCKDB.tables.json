      "headers": [
        "Use DuckDB when",
        "Use something else when"
      ],
      "rows": [
        [
          "Replacing pandas `.groupby().agg()` chains",
          "Need multi-user concurrent writes → PostgreSQL"
        ],
        [
          "Local ETL: read CSV/Parquet → transform → write Parquet",
          "Data doesn't fit on a single machine → Spark"
        ],
        [
          "Testing data pipelines without spinning up Spark",
          "Need a network-accessible server → PostgreSQL"
        ],
        [
          "Data exploration in Jupyter notebooks",
          "Multi-tenant app with row-level security → PostgreSQL"
        ],
        [
          "Querying S3/ADLS Parquet without a running cluster",
          "OLTP with many small writes → SQLite or PostgreSQL"
        ],
