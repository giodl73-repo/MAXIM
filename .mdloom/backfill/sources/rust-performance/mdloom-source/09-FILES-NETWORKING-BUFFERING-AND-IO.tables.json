      "heading_context": "## Small Calls vs Buffered Calls",
      "headers": [
        "Pattern",
        "Benefit",
        "Risk"
      ],
      "rows": [
        [
          "`BufReader`/`BufWriter`",
          "Amortizes syscalls, supports incremental processing",
          "Extra copy and buffer memory"
        ],
        [
          "`read_to_end` / `read_to_string`",
          "Simple, often efficient for bounded input",
          "Unbounded memory and delayed processing"
        ],
        [
          "Reused caller buffer",
          "Controls allocation and lifetime",
          "More plumbing"
        ],
        [
          "Memory mapping",
          "Demand paging, random access, fewer explicit reads",
          "Page faults, lifetime/truncation hazards, platform differences"
        ],
        [
          "Vectored I/O",
          "One call for several buffers",
          "OS may partially support; still handle partial writes"
        ]
      ]
    },
    {
      "id": "table-2",
