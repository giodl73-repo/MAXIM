      "heading_context": "## Networking and Backpressure",
      "headers": [
        "Layer",
        "Performance question"
      ],
      "rows": [
        [
          "Application framing",
          "Are messages copied, scanned, or reassembled repeatedly?"
        ],
        [
          "Socket calls",
          "Are writes tiny? Are reads sized to actual traffic?"
        ],
        [
          "TCP",
          "Is latency from RTT, Nagle/delayed ACK interaction, congestion, retransmit?"
        ],
        [
          "TLS",
          "Handshake reuse, record sizing, encryption CPU, certificate path"
        ],
        [
          "Runtime",
          "Are tasks woken efficiently and bounded?"
        ],
        [
          "Downstream",
          "Is the peer applying backpressure or timing out?"
        ]
      ]
    },
