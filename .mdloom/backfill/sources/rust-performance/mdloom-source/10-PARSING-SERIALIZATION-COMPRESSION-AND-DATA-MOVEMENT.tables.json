      "headers": [
        "Strategy",
        "Benefit",
        "Cost"
      ],
      "rows": [
        [
          "Borrow from input",
          "Fewer allocations/copies",
          "Lifetime coupling, buffer retention"
        ],
        [
          "Own each field",
          "Simple independent lifetime",
          "Allocations and copies"
        ],
        [
          "Intern/deduplicate",
          "Shares repeated values",
          "Lookup, synchronization, retained table"
        ],
        [
          "Arena per batch",
          "Cheap bulk lifetime",
          "Batch-scoped ownership and retained peak"
        ]
      ]
    },
