      "headers": [
        "Layout",
        "Best when",
        "Cost"
      ],
      "rows": [
        [
          "Array of structs",
          "Operations consume most fields per entity",
          "Simple ownership, good entity locality"
        ],
        [
          "Structure of arrays",
          "Hot loops consume a few fields across many entities",
          "More coordination; insertion/removal complexity"
        ],
        [
          "Hybrid/chunked",
          "Mixed operations and bounded working sets",
          "More design complexity"
        ]
      ]
    },
