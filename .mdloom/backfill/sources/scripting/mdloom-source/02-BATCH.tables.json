      "headers": [
        "Use Batch when...",
        "Use something else when..."
      ],
      "rows": [
        [
          "Legacy `.bat` scripts already exist and must not change",
          "Anything new on Windows — prefer PowerShell"
        ],
        [
          "Calling environment guarantees cmd.exe only, no PS",
