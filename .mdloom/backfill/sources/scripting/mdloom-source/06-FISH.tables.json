    {
      "id": "table-7",
      "line": 808,
      "heading_context": "## Gotchas & Traps",
      "headers": [
        "Trap",
        "Issue",
        "Fix"
      ],
      "rows": [
        [
          "`$?` doesn't exist",
          "Fish uses `$status`",
          "Use `$status` or `if cmd; ...`"
        ],
        [
          "No `export`",
          "`export VAR=val` is not native",
          "`set -gx VAR val` or `set -x VAR val`"
        ],
        [
          "`set var=value`",
          "Wrong: creates var named \"var=value\"",
          "`set var value` (no = !)"
        ],
        [
          "`()` vs `$()`",
          "Command sub is `(cmd)` not `$(cmd)`",
          "Fish: `set x (cmd)`"
        ],
        [
          "No POSIX compat",
          "Bash scripts don't run in Fish",
          "Don't `source` bash scripts in Fish"
        ],
        [
          "No `&&` / `||` (Fish <3.0)",
          "Old Fish used `; and` / `; or`",
          "Update to Fish 3.0+"
        ],
        [
          "`if/else/end` not `fi`",
          "Shell muscle memory",
          "`end` terminates all blocks"
        ],
        [
          "Universal vars persist",
          "`set -U x 1` persists forever",
          "Clean up with `set -eU x`"
        ],
        [
          "No `~/.fishrc`",
          "Config is `~/.config/fish/config.fish`",
          "XDG convention"
        ],
        [
          "Word-split in `()`",
          "`for x in (cmd)` splits on whitespace",
          "Fish has no workaround (use file or null-sep)"
        ]
      ]
    },
