      "rows": [
        [
          "High fatigue life, critical part",
          "Closed-die forge + aligned grain flow"
        ],
        [
          "Complex shape, high volume",
          "Closed-die (impression die) hot forging"
        ],
        [
          "Simple shape, tight tolerance",
          "Cold forging or precision warm forging"
        ],
        [
          "Very large part (> 10 tonnes)",
          "Open-die forging"
        ],
        [
          "Ring or cylindrical hollow",
          "Ring rolling"
        ],
