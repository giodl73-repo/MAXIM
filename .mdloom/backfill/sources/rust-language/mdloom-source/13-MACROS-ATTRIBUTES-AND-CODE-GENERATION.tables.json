      "heading_context": "## Old World -> New World Bridge",
      "headers": [
        "Old world",
        "Rust",
        "Difference"
      ],
      "rows": [
        [
          "C preprocessor `#define`",
          "`macro_rules!`",
          "Syntactic fragments + mixed-site hygiene avoid many capture bugs"
        ],
        [
          "C++ templates (codegen)",
          "generics ([06](06-TRAITS-GENERICS-AND-ASSOCIATED-ITEMS.md)) + macros",
          "Generics for types, macros for syntax"
        ],
        [
          "C# source generators (Roslyn)",
          "proc macros",
          "Same \"generate code at compile time\" role"
        ],
        [
          ".NET attributes + reflection",
          "attributes + derive macros",
          "Codegen at compile time, not runtime reflection"
        ],
        [
          "Java annotation processors",
          "derive/attribute macros",
          "Direct analog"
        ],
        [
          "`T4` templates / codegen tools",
          "`build.rs` + `quote`",
          "Integrated into the build"
        ],
        [
          "runtime reflection/serialization",
          "`#[derive(Serialize)]` (compile-time)",
          "No reflection cost; generated statically"
        ]
      ]
    },
