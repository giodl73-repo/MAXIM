      "headers": [
        "Property",
        "`const`",
        "`static`"
      ],
      "rows": [
        [
          "Semantics",
          "a value evaluated at each use; storage is a codegen choice",
          "one named memory location"
        ],
        [
          "Lifetime",
          "no storage identity of its own",
          "`'static`, lives whole program"
        ],
        [
          "Mutability",
          "always immutable",
          "immutable, or `static mut` (unsafe)"
        ],
        [
          "Address",
          "taking a reference may create/promote storage, but no unique named address is promised",
          "has one address (`&STATIC` is `'static`)"
        ],
        [
          "Type",
          "must be annotated",
          "must be annotated"
        ]
      ]
