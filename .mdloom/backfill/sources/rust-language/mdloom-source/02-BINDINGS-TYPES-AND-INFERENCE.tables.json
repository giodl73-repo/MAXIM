      "headers": [
        "Category",
        "Types",
        "Notes"
      ],
      "rows": [
        [
          "Signed int",
          "`i8 i16 i32 i64 i128 isize`",
          "`isize` = pointer width (index type)"
        ],
        [
          "Unsigned int",
          "`u8 u16 u32 u64 u128 usize`",
          "`usize` indexes collections"
        ],
        [
          "Float",
          "`f32 f64`",
          "IEEE-754; `f64` is the default float"
        ],
        [
          "Boolean",
          "`bool`",
          "1 byte; `true`/`false`, never coerces to/from int"
        ],
        [
          "Character",
          "`char`",
          "4 bytes; a Unicode scalar value, **not** a byte"
        ]
      ]
