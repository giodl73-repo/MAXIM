      "headers": [
        "I want to...",
        "Use"
      ],
      "rows": [
        [
          "Model \"has A and B\"",
          "`struct`"
        ],
        [
          "Model \"is A or B or C\"",
          "`enum`"
        ],
        [
          "A distinct type over one value",
          "newtype `struct Id(u64)`"
        ],
        [
          "Handle every case of an enum",
          "`match` (exhaustive)"
        ],
        [
          "React to just one variant",
          "`if let`"
        ],
        [
          "Loop while a pattern matches",
          "`while let`"
        ],
        [
          "Extract-or-bail without nesting",
          "`let ... else`"
        ],
        [
          "A boolean \"does it match?\"",
          "`matches!(x, Pat)`"
        ],
        [
          "Condition a pattern arm",
          "guard: `Pat if cond =>`"
        ],
        [
          "Make illegal states impossible",
          "encode invariants in enum variants"
