      "headers": [
        "I want to...",
        "Use"
      ],
      "rows": [
        [
          "Understand one compiler error deeply",
          "`rustc --explain E####`"
        ],
        [
          "Feed diagnostics to a tool",
          "`cargo build --message-format=json`, with tolerant parsing and toolchain-version tests"
        ],
        [
          "Promote warnings in an application CI build",
          "`cargo clippy -- -D warnings` or `RUSTFLAGS=\"-D warnings\"` with care"
        ],
        [
          "Silence an intentional local warning",
          "`#[allow(lint_name)]` at the narrowest scope"
        ],
        [
          "Enforce a lint as policy",
          "`[lints]` in `Cargo.toml` or `-D lint-name` in CI"
        ],
        [
          "Apply safe compiler fixes",
          "`cargo fix` and review the diff"
        ],
