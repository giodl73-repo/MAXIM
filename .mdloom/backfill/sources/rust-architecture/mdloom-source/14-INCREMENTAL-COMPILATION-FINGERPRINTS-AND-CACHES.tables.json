      "heading_context": "## The Red-Green Algorithm",
      "headers": [
        "Color",
        "Meaning",
        "Consequence"
      ],
      "rows": [
        [
          "Green",
          "rustc can prove the value is unchanged",
          "Reuse cached result or work product"
        ],
        [
          "Red",
          "Some observed input changed in a value-changing way",
          "Recompute and propagate invalidation"
        ],
        [
          "Unknown",
          "Not yet validated this session",
          "Walk dependencies until green/red is known"
        ]
      ]
    },
    {
