      "rows": [
        [
          "Source of E field lines",
          "∇·E = ρ/ε₀ (Gauss)"
        ],
        [
          "Do B field lines close?",
          "Always — ∇·B = 0"
        ],
        [
          "Changing B → what field?",
          "Curling E — Faraday"
        ],
        [
          "Current or changing E → what?",
          "Curling B — Ampere-Maxwell"
        ],
        [
          "Wave in vacuum",
          "∇²E = μ₀ε₀∂²E/∂t², c = 1/√(μ₀ε₀)"
        ],
        [
          "Energy flow direction",
          "S = E×B/μ₀ (Poynting vector)"
        ],
        [
          "Wave speed in material",
          "v = c/n, n = √(εᵣμᵣ)"
        ],
        [
          "Are Maxwell's equations relativistic?",
          "Yes — already exact"
        ]
      ]
    }
