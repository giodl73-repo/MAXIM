    {
      "id": "table-4",
      "line": 193,
      "heading_context": "## Decision Cheat Sheet",
      "headers": [
        "Use",
        "When"
      ],
      "rows": [
        [
          "Database constraint",
          "invariant can be enforced atomically in storage"
        ],
        [
          "Optimistic concurrency",
          "conflicts are rare and version checks are natural"
        ],
        [
          "Pessimistic lock",
          "conflict is expected and lock scope is short/bounded"
        ],
        [
          "Transaction",
          "multiple state changes form one durable invariant"
        ],
        [
          "Outbox",
          "durable state and asynchronous publication must not diverge"
        ],
        [
          "Idempotency record",
          "clients may repeat an operation after uncertain outcome"
        ],
        [
          "Bounded pool",
          "shared data system needs explicit concurrency admission"
        ],
        [
          "Expand/contract migration",
          "old and new versions overlap during rollout"
        ]
      ]
    }
