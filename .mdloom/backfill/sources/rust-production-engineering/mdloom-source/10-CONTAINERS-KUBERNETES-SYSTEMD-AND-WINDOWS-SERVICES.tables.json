      "id": "table-4",
      "line": 241,
      "heading_context": "## Decision Cheat Sheet",
      "headers": [
        "Use",
        "When"
      ],
      "rows": [
        [
          "Plain supervised process",
          "host count and rollout needs are modest"
        ],
        [
          "systemd",
          "Linux host integration, hardening, and journaling are sufficient"
        ],
        [
          "Windows service",
          "native SCM lifecycle and Windows operations are required"
        ],
        [
          "Container",
          "immutable filesystem/process packaging improves delivery"
        ],
        [
          "Kubernetes",
          "fleet scheduling, declarative rollout, and control-plane APIs justify complexity"
        ],
        [
          "Sidecar/proxy",
          "cross-cutting capability needs independent lifecycle and cost is accepted"
        ],
        [
          "Platform identity",
          "short-lived workload credentials are available"
        ]
      ]
