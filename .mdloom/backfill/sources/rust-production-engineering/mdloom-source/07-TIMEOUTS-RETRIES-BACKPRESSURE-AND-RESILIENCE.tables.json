      "headers": [
        "Pattern",
        "Use when",
        "Avoid when"
      ],
      "rows": [
        [
          "Breaker",
          "failures are correlated and attempts are expensive",
          "natural deadlines and shedding already suffice"
        ],
        [
          "Bulkhead",
          "workloads have distinct failure/capacity domains",
          "fragmentation would waste scarce capacity"
        ],
        [
          "Hedge",
          "read-like operation has rare long tails and spare capacity",
          "writes, overload, or expensive requests"
        ]
      ]
