    {
      "id": "table-3",
      "line": 276,
      "heading_context": "## Decision Cheat Sheet",
      "headers": [
        "Need",
        "Answer"
      ],
      "rows": [
        [
          "Name → IPv4",
          "A record"
        ],
        [
          "Name → IPv6",
          "AAAA record"
        ],
        [
          "Alias one name to another",
          "CNAME (not at the zone apex)"
        ],
        [
          "Point the apex at a load balancer",
          "ALIAS/ANAME (provider-specific)"
        ],
        [
          "Route mail",
          "MX records"
        ],
        [
          "Verify domain / mail auth (SPF, DKIM)",
          "TXT records"
        ],
        [
          "Restrict which CA can issue certs",
          "CAA record (ties to 06)"
        ],
        [
          "Fast propagation before a migration",
          "lower the TTL ahead of time"
        ],
        [
          "Fewer queries, outage resilience",
          "higher TTL"
        ],
        [
          "Nearest server, auto-failover, one IP",
          "anycast (BGP, 02)"
        ],
        [
          "Encrypt my DNS queries",
          "DoT (853) or DoH (443)"
        ],
        [
          "Prove answers aren't forged",
          "DNSSEC (signing, not encryption)"
        ],
        [
          "One small query/reply",
          "UDP/53; TCP/53 when too big"
        ]
      ]
    }
  ]
}