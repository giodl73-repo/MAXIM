      "headers": [
        "",
        "DoT",
        "DoH"
      ],
      "rows": [
        [
          "RFC",
          "7858",
          "8484"
        ],
        [
          "Port",
          "853 (dedicated)",
          "443 (shared with HTTPS)"
        ],
        [
          "Visibility",
          "identifiable as DNS by port",
          "blends into web traffic"
        ],
        [
          "Favored by",
          "network operators (manageable)",
