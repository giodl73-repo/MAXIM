      "heading_context": "## System, Vendored, or Prebuilt",
      "headers": [
        "Native supply model",
        "Advantages",
        "Risks/costs"
      ],
      "rows": [
        [
          "System package",
          "Security servicing integrates with OS; smaller Rust build",
          "Version drift, distro variance, deployment dependency"
        ],
        [
          "Vendored source built by crate",
          "Consistent source and easier static packaging",
          "Longer builds, duplicate patch channel, compiler requirements"
        ],
        [
          "Prebuilt binary",
          "Fast and can simplify proprietary SDK use",
          "Platform matrix, provenance, ABI, signing, redistribution"
        ],
        [
          "Organization-built artifact",
          "Controlled flags and patching",
          "Internal release/retention/support burden"
        ]
      ]
    },
