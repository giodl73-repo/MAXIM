      "headers": [
        "Strategy",
        "Mechanism",
        "Examples"
      ],
      "rows": [
        [
          "MHC I downregulation",
          "TAP inhibition or MHC I degradation → CTL can't see infected cells",
          "HSV ICP47 (blocks TAP), CMV US11/US6, HIV Nef"
        ],
        [
          "Interferon antagonism",
          "Block IFN signaling to prevent antiviral state",
          "Influenza NS1 (blocks RIG-I), Ebola VP35, COVID-19 NSP3/16"
        ],
        [
          "Complement evasion",
          "Viral proteins mimic complement regulators",
          "HSV gC (binds C3b), CMV virion incorporates host CD55/CD59"
        ],
        [
          "Latency",
          "Minimal viral gene expression → invisible to immune system",
          "All herpesviruses, HIV provirus"
        ],
        [
          "Antigenic variation",
          "Rapid mutation of surface proteins",
          "Influenza (drift/shift), HIV (escape mutations in CTL epitopes)"
        ],
        [
          "Immunosuppression",
          "Direct killing of immune cells",
          "HIV (CD4+ T cell depletion), measles (immune amnesia via CD150)"
        ],
        [
          "Decoy receptors",
          "Secrete soluble cytokine receptor analogs",
          "Poxviruses (vaccinia encodes numerous immune evasion genes)"
        ]
      ]
