      "heading_context": "## ML-Based PDE Methods at a Glance",
      "headers": [
        "Method",
        "Core Idea",
        "Strengths",
        "Limitations"
      ],
      "rows": [
        [
          "**PINNs**",
          "Parameterize u as neural net; minimize PDE residual as loss",
          "Mesh-free; handles inverse problems naturally",
          "Spectral bias; no rigorous error bounds; training instability"
        ],
        [
          "**FNO**",
          "Learn solution operator G: f → u in Fourier space",
          "Amortized: one training, instant evaluation; O(N log N)",
          "Requires training data from classical solvers; periodic domains preferred"
        ],
        [
          "**DeepONet**",
          "Branch (input function) + trunk (eval point) → inner product",
          "Handles variable domains; flexible architecture",
          "More training data needed; less spectral structure"
        ],
        [
          "**Diffusion models**",
          "Forward noising = heat equation on probability density; reverse = learned score-driven SDE",
          "State-of-the-art generative models",
          "Not PDE solvers per se — the PDE is the mechanism, not the target"
        ]
      ]
    },
