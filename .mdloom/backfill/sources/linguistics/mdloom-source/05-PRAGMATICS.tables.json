      "id": "table-2",
      "line": 358,
      "heading_context": "## Part VII: Presupposition (Pragmatic Treatment)",
      "headers": [
        "Trigger",
        "Presupposition",
        "Example"
      ],
      "rows": [
        [
          "**Definite descriptions**",
          "Existence + uniqueness",
          "\"The king of France\" → ∃ king of France"
        ],
        [
          "**Change of state verbs**",
          "Prior state",
          "\"stop\" → was doing it; \"start\" → wasn't doing it"
        ],
        [
          "**Factive verbs**",
          "Truth of complement",
          "\"know/realize/regret\" → complement is true"
        ],
        [
          "**Iterative \"again\"**",
          "Prior occurrence",
          "\"She came back again\" → she came before"
        ],
        [
          "**Temporal clauses**",
          "Truth of temporal clause",
          "\"Before she left\" → she left"
        ],
        [
          "**Clefts**",
          "All-but-focus is presupposed",
          "\"It was John who left\" → someone left"
        ],
        [
          "**Implicative verbs**",
          "",
          "\"He managed to leave\" → it was difficult to leave"
        ]
      ]
    },
