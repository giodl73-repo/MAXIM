      "headers": [
        "Manner",
        "Definition",
        "Example"
      ],
      "rows": [
        [
          "**Plosive / Stop**",
          "Complete closure, then release",
          "[p t k b d g ʔ]"
        ],
        [
          "**Nasal**",
          "Complete oral closure, velum lowered — air through nose",
          "[m n ŋ]"
        ],
        [
          "**Fricative**",
          "Narrow constriction, turbulent airflow",
          "[f v s z ʃ ʒ h]"
        ],
        [
          "**Affricate**",
          "Stop released as fricative at same/adjacent place",
          "[tʃ dʒ ts]"
        ],
        [
          "**Approximant**",
          "Constriction narrower than vowel, no turbulence",
          "[j w ɹ ʋ]"
        ],
        [
          "**Lateral**",
          "Partial closure, air flows around sides of tongue",
          "[l ɭ ʎ]"
        ],
        [
          "**Trill**",
          "Articulator vibrates from airstream",
          "[r ʀ] (Spanish r, French R)"
        ],
        [
          "**Tap/Flap**",
          "Single rapid tap of articulator",
          "[ɾ] (Spanish r single, American \"butter\")"
        ]
      ]
    },
