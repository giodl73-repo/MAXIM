      "heading_context": "## Part VI: Phonological Rules",
      "headers": [
        "Type",
        "Description",
        "Example"
      ],
      "rows": [
        [
          "**Voicing assimilation**",
          "Obstruent assimilates in voicing",
          "\"have to\" → [hæftə] (v→f before voiceless t)"
        ],
        [
          "**Nasal assimilation**",
          "Nasal assimilates place of following stop",
          "\"impossible\" — [m] before bilabial p; \"incredible\" — [ŋ] before velar k"
        ],
        [
          "**Vowel nasalization**",
          "Vowel nasalized before nasal consonant",
          "\"man\" — [mæ̃n]"
        ],
        [
          "**Palatalization**",
          "Consonant palatalizes before front vowel",
          "\"did you\" → [dɪdʒu]"
        ]
      ]
    },
