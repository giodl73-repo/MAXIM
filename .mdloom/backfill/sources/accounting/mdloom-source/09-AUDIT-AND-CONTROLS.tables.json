      "headers": [
        "Question",
        "Where to look"
      ],
      "rows": [
        [
          "Are these numbers trustworthy?",
          "Audit opinion (want unqualified) + internal-control attestation"
        ],
        [
          "Is the firm a going concern?",
          "Going-concern paragraph in the audit report"
        ],
        [
          "Is revenue being recognized aggressively?",
          "ASC 606 disclosures; NI-vs-CFO gap; AR growth vs revenue"
        ],
        [
          "Are earnings being smoothed?",
          "Reserve movements; consistency of \"exact\" beats"
        ],
        [
          "Is leverage understated?",
          "Off-balance-sheet items, lease/SPE footnotes"
        ],
        [
          "GAAP or IFRS firm — comparable?",
          "Check LIFO, R&D, PP&E revaluation choices before comparing"
        ],
        [
          "Who is personally accountable?",
          "SOX 302 certification (CEO/CFO)"
        ],
        [
          "Where's the fraud risk concentrated?",
          "Revenue recognition + management estimates"
        ]
      ]
