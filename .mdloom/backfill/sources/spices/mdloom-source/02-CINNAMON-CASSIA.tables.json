      "headers": [
        "Question",
        "Answer"
      ],
      "rows": [
        [
          "How do I know if I bought Ceylon vs cassia?",
          "Physical: multiple thin layers = Ceylon; single thick curl = cassia. Chemical: coumarin content by GC-MS"
        ],
        [
          "Is cinnamon safe in large quantities?",
          "Depends on species. Ceylon: yes. Cassia: coumarin limits apply — supplement doses problematic, culinary use fine"
        ],
        [
          "What's the flavor difference?",
          "Ceylon = delicate, floral, complex. Cassia (especially Vietnamese) = intense, sweet, \"cinnamon candy\" profile"
        ],
        [
          "Why does US cinnamon taste different from Mexican cinnamon?",
          "US = cassia; Mexico = Ceylon"
        ],
        [
          "What's cinnamaldehyde's mechanism?",
          "TRPA1 agonist → mild burning/warming. Also antibacterial in vitro"
        ],
        [
          "Is coumarin the same as warfarin?",
          "No. Coumarin = benzopyranone. Warfarin = 4-hydroxycoumarin anticoagulant. Different structures, different mechanisms."
        ]
      ]
