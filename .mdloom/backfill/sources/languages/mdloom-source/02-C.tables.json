        [
          "`string` is object, `==` compares value",
          "`char*` comparison with `==` compares addresses",
          "Silent logic bug"
        ],
        [
          "`int` is 32-bit always",
          "`int` is \"at least 16 bits\" (usually 32)",
          "Use `int32_t`"
        ],
        [
          "Arithmetic on `int` wraps in `checked {}` context",
          "Signed overflow is **undefined behavior**",
          "Silent wrong results"
        ],
        [
          "Array bounds checked",
          "Array access unchecked",
          "Buffer overflow → UB or exploit"
        ],
        [
          "`foreach` iterates safely",
          "`for (int i = 0; i <= n; i++)` with off-by-one = UB",
          "Off-by-one reads garbage"
        ],
        [
          "`null` is type-safe",
          "`NULL` is `0` cast to pointer",
          "Confuses int and pointer"
        ],
        [
          "GC manages memory",
          "Must `free` every `malloc`",
          "Memory leaks, double-free"
        ]
      ]
