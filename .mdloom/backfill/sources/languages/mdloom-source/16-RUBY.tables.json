      "rows": [
        [
          "Block (`{ }` or `do..end`)",
          "`return` exits enclosing method",
          "Loose (extra args ignored)",
          "Passing behavior to an iterator; `yield`"
        ],
        [
          "`proc { }`",
          "`return` exits enclosing method",
          "Loose",
          "Stored callable; don't care about strict arity"
        ],
        [
          "`lambda { }` / `->(){}`",
          "`return` exits only the lambda",
          "Strict (wrong arity raises ArgumentError)",
          "Stored callable that should behave like a method; use as default for new code"
        ]
      ]
