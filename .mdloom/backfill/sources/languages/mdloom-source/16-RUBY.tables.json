      "headers": [
        "Method",
        "Where it inserts",
        "Effect",
        "Use when"
      ],
      "rows": [
        [
          "`include M`",
          "After class in lookup chain",
          "M's methods become instance methods",
          "Sharing behavior across instances (the normal mixin)"
        ],
        [
          "`extend M`",
          "On the singleton class",
          "M's methods become class-level methods on receiver",
          "Adding class methods; can also call `extend` on an object instance"
        ],
        [
          "`prepend M`",
          "Before class in lookup chain",
          "M's methods wrap the class's own methods",
          "Decoration / AOP — intercept calls before they reach the class"
        ]
      ]
    },
    {
