      "headers": [
        "Method",
        "Tests",
        "Override for",
        "Hash/Set key use"
      ],
      "rows": [
        [
          "`==`",
          "Value equality (semantic)",
          "Domain equality (Date == Date, Array == Array)",
          "Not used for hashing"
        ],
        [
          "`eql?`",
          "Type + value equality",
          "When `hash` is also overridden; used by Hash for key comparison",
          "Yes — Hash keys use `eql?` + `hash`"
        ],
        [
          "`equal?`",
          "Object identity (same pointer)",
          "Never override — it's `ReferenceEquals`",
          "No"
        ]
      ]
