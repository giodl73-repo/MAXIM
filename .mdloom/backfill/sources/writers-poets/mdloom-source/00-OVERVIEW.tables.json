      "rows": [
        [
          "**Epic**",
          "Long narrative poem of heroic deeds; invocation of muse; begins in medias res",
          "Iliad, Odyssey, Aeneid"
        ],
        [
          "**Free indirect discourse**",
          "Third-person narration that adopts character's voice without quotation marks",
          "Austen, Flaubert"
        ],
        [
          "**Stream of consciousness**",
          "Interior monologue following thought's associative flow",
          "Joyce (Molly Bloom), Woolf"
        ],
        [
          "**Unreliable narrator**",
          "Narrator whose account contradicts evidence elsewhere in text",
          "Nabokov (Humbert Humbert), Ishiguro"
        ],
        [
          "**Metafiction**",
          "Fiction that comments on its own fictionality",
          "Borges, Nabokov, Calvino"
        ],
        [
          "**Magical realism**",
          "Realistic narration of extraordinary events treated as ordinary",
          "Garcia Marquez"
        ],
        [
          "**Villanelle**",
          "19-line poem with 2 refrains and specific rhyme scheme",
          "Dylan Thomas \"Do Not Go Gentle\""
        ],
        [
          "**Petrarchan sonnet**",
          "14 lines: octave (8) + sestet (6); problem + resolution",
          "Petrarch, Shakespeare"
        ],
        [
          "**In medias res**",
          "Beginning a narrative in the middle of the action",
          "Homer (Iliad), most epics"
        ],
        [
          "**Ekphrasis**",
          "Verbal description of a visual artwork within a literary text",
          "Homer (Shield of Achilles), Keats (\"Ode on a Grecian Urn\")"
        ]
      ]
