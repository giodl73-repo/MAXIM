        "maxim_schema": "maxim.frontmatter.v1",
        "module": "dynamical-systems",
        "remap_from": "[]",
        "remap_to": "[]",
        "root_concepts": "[applications]",
        "section": "dynamical-systems",
        "source_custody": "partial",
        "status": "source-custody",
        "title": "Applications",
        "updated": "null"
      },
      "text": "Mean-field rewrite:  theta_i' = omega_i + K r sin(psi - theta_i)\n   -> each oscillator is pulled toward the mean phase with strength K*r."
    },
