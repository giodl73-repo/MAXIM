        "root_concepts": "[applications]",
        "section": "dynamical-systems",
        "source_custody": "partial",
        "status": "source-custody",
        "title": "Applications",
        "updated": "null"
      },
      "text": "```\n   N phase oscillators, natural frequencies omega_i, coupling K:"
    },
    {
      "id": "09-APPLICATIONS.md#008",
      "path": [
        "09-APPLICATIONS.md"
      ],
      "level": 0,
      "line": 1,
      "metadata": {
        "backsource_ids": "[proof-backfill:dynamical-systems:09-applications, git-history:dynamical-systems:09-applications]",
