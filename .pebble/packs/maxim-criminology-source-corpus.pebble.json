        "root_concepts": "[overview]",
        "section": "criminology",
        "source_custody": "partial",
        "status": "source-custody",
        "title": "Criminology - Landscape and Taxonomy",
        "updated": "null"
      },
      "text": "Criminology spans explanatory theory (why crime occurs), institutional analysis (how justice systems respond), and policy evaluation (what interventions actually work). The field sits at the intersection of sociology, psychology, economics, and law."
    },
