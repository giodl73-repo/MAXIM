        "current_path": "criminology/00-OVERVIEW.md",
        "id": "maxim:criminology:overview",
        "index_roles": "[guide, root-concept]",
        "kind": "guide",
        "maxim_schema": "maxim.frontmatter.v1",
        "module": "criminology",
        "remap_from": "[]",
