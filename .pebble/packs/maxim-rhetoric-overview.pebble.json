        "root_concepts": "[overview]",
        "section": "rhetoric",
        "source_custody": "partial",
        "status": "source-custody",
        "title": "Rhetoric - Overview and Landscape",
        "updated": "null"
      },
      "text": "FORENSIC:\n  - Incident retrospectives (postmortems)\n  - Performance reviews\n  - Security breach explanations\n  - \"What went wrong and who was responsible?\"\n  → This genre is about establishing what happened and\n    attributing responsibility fairly."
    },
    {
