        "root_concepts": "[french]",
        "section": "world-languages",
        "source_custody": "partial",
        "status": "source-custody",
        "title": "French - Language Reference",
        "updated": "null"
      },
      "text": "CONSONANTS\n  R  = uvular fricative [ʁ] — from the back of the throat, NOT like Spanish R\n  Silent final consonants — the core French pronunciation rule:\n    Most final consonants are SILENT:\n    \"les\" [le], \"est\" [ε], \"grand\" [grɑ̃], \"Paris\" [paʁi]"
    },
    {
      "id": "04-FRENCH.md#012",
      "path": [
        "04-FRENCH.md"
      ],
      "level": 0,
      "line": 1,
      "metadata": {
        "backsource_ids": "[proof-backfill:world-languages:04-french, git-history:world-languages:04-french]",
