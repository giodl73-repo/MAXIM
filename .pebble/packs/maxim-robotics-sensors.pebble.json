        "concepts": "[sensors]",
        "current_path": "robotics/03-SENSORS.md",
        "id": "maxim:robotics:sensors",
        "index_roles": "[guide, root-concept]",
        "kind": "guide",
        "maxim_schema": "maxim.frontmatter.v1",
        "module": "robotics",
        "remap_from": "[]",
        "remap_to": "[]",
        "root_concepts": "[sensors]",
        "section": "robotics",
        "source_custody": "partial",
        "status": "source-custody",
        "title": "Robotics - Sensors",
        "updated": "null"
      },
      "text": "OPTICAL ENCODER: LED + photodetector array reads slots in disk.\n  Resolution: 512 to 1,000,000 counts/rev (10-20 bit).\n  Fragile (vibration, contamination)."
    },
    {
      "id": "03-SENSORS.md#012",
      "path": [
        "03-SENSORS.md"
      ],
      "level": 0,
      "line": 1,
      "metadata": {
        "backsource_ids": "[proof-backfill:robotics:03-sensors, git-history:robotics:03-sensors]",
        "canonical_path": "robotics/03-SENSORS.md",
        "concepts": "[sensors]",
        "current_path": "robotics/03-SENSORS.md",
        "id": "maxim:robotics:sensors",
        "index_roles": "[guide, root-concept]",
        "kind": "guide",
        "maxim_schema": "maxim.frontmatter.v1",
        "module": "robotics",
