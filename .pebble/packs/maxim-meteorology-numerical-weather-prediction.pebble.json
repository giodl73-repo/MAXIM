        "id": "maxim:meteorology:numerical-weather-prediction",
        "index_roles": "[guide, root-concept]",
        "kind": "guide",
        "maxim_schema": "maxim.frontmatter.v1",
        "module": "meteorology",
        "remap_from": "[]",
