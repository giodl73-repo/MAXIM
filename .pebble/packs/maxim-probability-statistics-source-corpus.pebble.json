        "root_concepts": "[overview]",
        "section": "probability-statistics",
        "source_custody": "partial",
        "status": "source-custody",
        "title": "Probability and Statistics - Landscape Overview",
        "updated": "null"
      },
      "text": "**The payoff**: Discrete and continuous distributions are unified. The expectation E[X] is a Lebesgue integral — no separate formulas for \"sum over discrete\" vs. \"integrate over density.\""
    },
