    },
    {
      "id": "00-OVERVIEW.md#002",
      "path": [
        "00-OVERVIEW.md"
      ],
      "level": 0,
      "line": 1,
      "metadata": {
        "backsource_ids": "[proof-backfill:robotics:00-overview, git-history:robotics:00-overview]",
        "canonical_path": "robotics/00-OVERVIEW.md",
        "concepts": "[overview]",
