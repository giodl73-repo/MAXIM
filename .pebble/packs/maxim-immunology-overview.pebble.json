      "text": "TWO-ARM ARCHITECTURE:"
    },
    {
      "id": "00-OVERVIEW.md#005",
      "path": [
        "00-OVERVIEW.md"
      ],
      "level": 0,
      "line": 1,
      "metadata": {
        "backsource_ids": "[proof-backfill:immunology:00-overview, git-history:immunology:00-overview]",
