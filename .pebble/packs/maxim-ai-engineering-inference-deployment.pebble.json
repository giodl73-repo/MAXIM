      "text": "## KV Cache — The Central Memory Problem"
    },
    {
      "id": "08-INFERENCE-DEPLOYMENT.md#006",
      "path": [
        "08-INFERENCE-DEPLOYMENT.md"
      ],
      "level": 0,
      "line": 1,
      "metadata": {
        "backsource_ids": "[proof-backfill:ai-engineering:08-inference-deployment, git-history:ai-engineering:08-inference-deployment]",
        "canonical_path": "ai-engineering/08-INFERENCE-DEPLOYMENT.md",
