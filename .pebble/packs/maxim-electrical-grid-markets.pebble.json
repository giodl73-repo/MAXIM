        "concepts": "[markets]",
        "current_path": "electrical-grid/08-MARKETS.md",
        "id": "maxim:electrical-grid:markets",
        "index_roles": "[guide, root-concept]",
        "kind": "guide",
        "maxim_schema": "maxim.frontmatter.v1",
        "module": "electrical-grid",
        "remap_from": "[]",
