      "text": "### Thermal Convection"
    },
    {
      "id": "13-GEOPHYSICS.md#029",
      "path": [
        "13-GEOPHYSICS.md"
      ],
      "level": 0,
      "line": 1,
      "metadata": {
        "backsource_ids": "[proof-backfill:natural-sciences:13-geophysics, git-history:natural-sciences:13-geophysics]",
        "canonical_path": "natural-sciences/13-GEOPHYSICS.md",
