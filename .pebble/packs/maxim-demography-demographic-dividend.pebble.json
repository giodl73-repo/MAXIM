        "current_path": "demography/09-DEMOGRAPHIC-DIVIDEND.md",
        "id": "maxim:demography:demographic-dividend",
        "index_roles": "[guide, root-concept]",
        "kind": "guide",
        "maxim_schema": "maxim.frontmatter.v1",
