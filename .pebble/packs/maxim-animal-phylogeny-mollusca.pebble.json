      "text": "### Shell Layers"
    },
    {
      "id": "05-MOLLUSCA.md#012",
      "path": [
        "05-MOLLUSCA.md"
      ],
      "level": 0,
      "line": 1,
      "metadata": {
        "backsource_ids": "[proof-backfill:animal-phylogeny:05-mollusca, git-history:animal-phylogeny:05-mollusca]",
        "canonical_path": "animal-phylogeny/05-MOLLUSCA.md",
