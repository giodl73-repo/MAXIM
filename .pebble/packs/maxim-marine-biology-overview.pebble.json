    {
      "id": "00-OVERVIEW.md#004",
      "path": [
        "00-OVERVIEW.md"
      ],
      "level": 0,
      "line": 1,
      "metadata": {
        "backsource_ids": "[proof-backfill:marine-biology:00-overview, git-history:marine-biology:00-overview]",
        "canonical_path": "marine-biology/00-OVERVIEW.md",
