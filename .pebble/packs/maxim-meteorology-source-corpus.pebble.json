        "concepts": "[overview]",
        "current_path": "meteorology/00-OVERVIEW.md",
        "id": "maxim:meteorology:overview",
        "index_roles": "[guide, root-concept]",
        "kind": "guide",
        "maxim_schema": "maxim.frontmatter.v1",
        "module": "meteorology",
        "remap_from": "[]",
