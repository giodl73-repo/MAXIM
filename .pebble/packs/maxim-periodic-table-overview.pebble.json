        "root_concepts": "[overview]",
        "section": "periodic-table",
        "source_custody": "partial",
        "status": "source-custody",
        "title": "The Periodic Table - Overview and Framework",
        "updated": "null"
      },
      "text": "The modern restatement fixed Mendeleev's ordering anomalies (e.g., Te before I despite higher mass —\ntellurium has 52 protons, iodine 53; the *number* of protons always gives the right ordering)."
    },
