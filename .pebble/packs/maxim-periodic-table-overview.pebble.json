      "path": [
        "00-OVERVIEW.md"
      ],
      "level": 0,
      "line": 1,
      "metadata": {
        "backsource_ids": "[proof-backfill:periodic-table:00-overview, git-history:periodic-table:00-overview]",
        "canonical_path": "periodic-table/00-OVERVIEW.md",
