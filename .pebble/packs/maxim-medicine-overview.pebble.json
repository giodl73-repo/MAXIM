        "module": "medicine",
        "remap_from": "[]",
        "remap_to": "[]",
        "root_concepts": "[overview]",
        "section": "medicine",
        "source_custody": "partial",
        "status": "source-custody",
        "title": "00 - Medicine and Pharmacology Overview",
        "updated": "null"
      },
      "text": "EC50: concentration producing 50% maximal effect\nEmax: maximum possible effect\nPotency: EC50 comparison (lower EC50 = more potent)\nEfficacy: Emax comparison (which drug can produce greater maximal effect)"
    },
    {
      "id": "00-OVERVIEW.md#040",
      "path": [
        "00-OVERVIEW.md"
      ],
      "level": 0,
      "line": 1,
      "metadata": {
