      "text": "### Simply Connected Spaces"
    },
    {
      "id": "06-FUNDAMENTAL-GROUP.md#014",
      "path": [
        "06-FUNDAMENTAL-GROUP.md"
      ],
      "level": 0,
      "line": 1,
