        "updated": "null"
      },
      "text": "Nuclear deterrence is applied game theory: you're trying to influence another\nrational actor's decisions by making certain outcomes too costly to risk. The\nintellectual framework, developed 1945–1965, remains the logic governing the\nworld's most consequential military postures."
    },
    {
      "id": "02-NUCLEAR-DETERRENCE.md#003",
      "path": [
        "02-NUCLEAR-DETERRENCE.md"
      ],
      "level": 0,
      "line": 1,
      "metadata": {
        "backsource_ids": "[proof-backfill:political-science:02-nuclear-deterrence, git-history:political-science:02-nuclear-deterrence]",
        "canonical_path": "political-science/02-NUCLEAR-DETERRENCE.md",
        "concepts": "[nuclear, deterrence]",
        "current_path": "political-science/02-NUCLEAR-DETERRENCE.md",
        "id": "maxim:political-science:nuclear-deterrence",
        "index_roles": "[guide, root-concept]",
        "kind": "guide",
        "maxim_schema": "maxim.frontmatter.v1",
        "module": "political-science",
        "remap_from": "[]",
