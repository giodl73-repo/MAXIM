      "text": "```\nVERTEBRATE DIVERSITY\n====================="
    },
    {
      "id": "00-OVERVIEW.md#027",
      "path": [
        "00-OVERVIEW.md"
      ],
      "level": 0,
      "line": 1,
      "metadata": {
        "backsource_ids": "[proof-backfill:zoology:00-overview, git-history:zoology:00-overview]",
