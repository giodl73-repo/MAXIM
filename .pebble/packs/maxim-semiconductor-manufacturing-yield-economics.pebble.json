        "id": "maxim:semiconductor-manufacturing:yield-economics",
        "index_roles": "[guide, root-concept]",
        "kind": "guide",
        "maxim_schema": "maxim.frontmatter.v1",
        "module": "semiconductor-manufacturing",
        "remap_from": "[]",
