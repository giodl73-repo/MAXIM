        "title": "Typography - Overview: Frozen Language",
        "updated": "null"
      },
      "text": "Typography is applied linguistics made permanent. Every letterform you render in a browser, every font you ship in an app, every word on this screen is the product of 5,200 years of decisions about how to externalize human thought into marks."
    },
    {
      "id": "00-OVERVIEW.md#003",
      "path": [
        "00-OVERVIEW.md"
      ],
      "level": 0,
      "line": 1,
      "metadata": {
        "backsource_ids": "[proof-backfill:typography:00-overview, git-history:typography:00-overview]",
        "canonical_path": "typography/00-OVERVIEW.md",
        "concepts": "[overview]",
        "current_path": "typography/00-OVERVIEW.md",
        "id": "maxim:typography:overview",
        "index_roles": "[guide, root-concept]",
