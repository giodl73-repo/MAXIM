        "current_path": "literature/03-DRAMA.md",
        "id": "maxim:literature:drama",
        "index_roles": "[guide, root-concept]",
        "kind": "guide",
        "maxim_schema": "maxim.frontmatter.v1",
        "module": "literature",
        "remap_from": "[]",
        "remap_to": "[]",
        "root_concepts": "[drama]",
        "section": "literature",
        "source_custody": "partial",
        "status": "source-custody",
        "title": "Drama",
        "updated": "null"
      },
      "text": "**Anagnorisis** — recognition or discovery. The moment when the hero (or another character) passes from ignorance to knowledge."
    },
    {
      "id": "03-DRAMA.md#021",
      "path": [
        "03-DRAMA.md"
      ],
      "level": 0,
      "line": 1,
