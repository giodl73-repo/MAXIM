        "maxim_schema": "maxim.frontmatter.v1",
        "module": "literature",
        "remap_from": "[]",
        "remap_to": "[]",
        "root_concepts": "[drama]",
        "section": "literature",
        "source_custody": "partial",
        "status": "source-custody",
        "title": "Drama",
        "updated": "null"
      },
      "text": "3. DIANOIA (thought/reasoning)\n   What characters think and argue; the intellectual content.\n   Related to rhetoric: how characters make arguments."
    },
    {
      "id": "03-DRAMA.md#011",
      "path": [
        "03-DRAMA.md"
      ],
      "level": 0,
      "line": 1,
      "metadata": {
        "backsource_ids": "[proof-backfill:literature:03-drama, git-history:literature:03-drama]",
