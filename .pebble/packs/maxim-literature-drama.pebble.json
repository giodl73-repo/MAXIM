        "current_path": "literature/03-DRAMA.md",
        "id": "maxim:literature:drama",
        "index_roles": "[guide, root-concept]",
        "kind": "guide",
        "maxim_schema": "maxim.frontmatter.v1",
        "module": "literature",
        "remap_from": "[]",
        "remap_to": "[]",
        "root_concepts": "[drama]",
        "section": "literature",
        "source_custody": "partial",
        "status": "source-custody",
        "title": "Drama",
        "updated": "null"
      },
      "text": "4. LEXIS (diction/language)\n   The actual words used. Style, register, meter (iambic trimeter\n   for dialogue, various lyric meters for choral odes)."
    },
    {
      "id": "03-DRAMA.md#012",
      "path": [
        "03-DRAMA.md"
      ],
      "level": 0,
      "line": 1,
      "metadata": {
        "backsource_ids": "[proof-backfill:literature:03-drama, git-history:literature:03-drama]",
        "canonical_path": "literature/03-DRAMA.md",
        "concepts": "[drama]",
        "current_path": "literature/03-DRAMA.md",
        "id": "maxim:literature:drama",
        "index_roles": "[guide, root-concept]",
