        "id": "maxim:mineralogy:carbonates-phosphates",
        "index_roles": "[guide, root-concept]",
        "kind": "guide",
        "maxim_schema": "maxim.frontmatter.v1",
        "module": "mineralogy",
        "remap_from": "[]",
