      "text": "## 0. Object Pipeline → Text Stream: The Fundamental Shift"
    },
    {
      "id": "00-OVERVIEW.md#003",
      "path": [
        "00-OVERVIEW.md"
      ],
      "level": 0,
      "line": 1,
      "metadata": {
        "backsource_ids": "[proof-backfill:scripting:00-overview, git-history:scripting:00-overview]",
        "canonical_path": "scripting/00-OVERVIEW.md",
        "concepts": "[overview]",
        "current_path": "scripting/00-OVERVIEW.md",
        "id": "maxim:scripting:overview",
        "index_roles": "[guide, root-concept]",
        "kind": "guide",
