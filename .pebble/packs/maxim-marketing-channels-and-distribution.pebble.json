        "concepts": "[channel design, distribution, retail, omnichannel, channel conflict, place]",
        "current_path": "marketing/06-CHANNELS-AND-DISTRIBUTION.md",
        "id": "maxim:marketing:channels-and-distribution",
        "index_roles": "[guide]",
