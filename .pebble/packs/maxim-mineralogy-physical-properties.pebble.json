        "id": "maxim:mineralogy:physical-properties",
        "index_roles": "[guide, root-concept]",
        "kind": "guide",
        "maxim_schema": "maxim.frontmatter.v1",
        "module": "mineralogy",
        "remap_from": "[]",
        "remap_to": "[]",
        "root_concepts": "[physical, properties]",
        "section": "mineralogy",
        "source_custody": "partial",
        "status": "source-custody",
        "title": "Physical Properties of Minerals",
        "updated": "null"
      },
      "text": "CLEAVAGE ANGLES (critical for ID)\n  Cubic:          3 planes at 90° (halite, galena)\n  Octahedral:     4 planes at 70.5°/109.5° (fluorite, diamond)\n  Rhombohedral:   3 planes at ~75° (calcite)\n  Prismatic:      2 planes parallel to length (feldspar, pyroxene)\n  Basal:          1 plane perpendicular to c-axis (mica)\n  Pinacoidal:     2 planes perpendicular to axis"
    },
