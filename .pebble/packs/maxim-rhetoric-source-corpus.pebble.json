      "text": "## The Three Genres of Rhetoric"
    },
    {
      "id": "00-OVERVIEW.md#006",
      "path": [
        "00-OVERVIEW.md"
      ],
      "level": 0,
      "line": 1,
      "metadata": {
        "backsource_ids": "[proof-backfill:rhetoric:00-overview, git-history:rhetoric:00-overview]",
        "canonical_path": "rhetoric/00-OVERVIEW.md",
        "concepts": "[overview]",
